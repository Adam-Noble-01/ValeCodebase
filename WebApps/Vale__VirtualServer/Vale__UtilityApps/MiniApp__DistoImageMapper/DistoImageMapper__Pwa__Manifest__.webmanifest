{
    "id": "/disto-app/",
    "name": "Disto Image Mapper",
    "short_name": "Disto Mapper",
    "description": "Turns a Leica DISTO survey folder into an interactive 3D photo atlas.",
    "categories": ["productivity", "business", "utilities"],
    "lang": "en-GB",
    "dir": "ltr",
    "start_url": "./DistoImageMapper__AppIndex__.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "orientation": "any",
    "theme_color": "#172b3a",
    "background_color": "#172b3a",
    "icons": [
        { "src": "01__AppAssets/DistoImageMapper__AppIcon__192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "01__AppAssets/DistoImageMapper__AppIcon__192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "01__AppAssets/DistoImageMapper__AppIcon__512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "01__AppAssets/DistoImageMapper__AppIcon__512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "related_applications": [
        { "platform": "webapp", "url": "https://app.valegardenhouses.com/disto-app/DistoImageMapper__Pwa__Manifest__.webmanifest" }
    ],
    "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
    "handle_links": "preferred",
    "prefer_related_applications": false
}
