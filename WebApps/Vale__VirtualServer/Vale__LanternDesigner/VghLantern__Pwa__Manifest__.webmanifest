        { "src": "01__AppAssets__VghLantern/Na__VghLanternApp__Icon__192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "01__AppAssets__VghLantern/Na__VghLanternApp__Icon__512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "01__AppAssets__VghLantern/Na__VghLanternApp__Icon__512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
