+        if (guard.isJson || type.indexOf('json') !== -1) return 'json';
+        if (guard.isText || type.indexOf('text/') === 0 || type.indexOf('svg') !== -1 || type.indexOf('xml') !== -1) return 'text';
+        return 'binary';
+    }
+    // ------------------------------------------------------------
+
+
+    // HELPER FUNCTION | What Was Stored, for Every Answer
+    // ------------------------------------------------------------
