<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parametric Window Configurator (Maker.js)</title>
    
    <!-- Master Stylesheet -->
    <link rel="stylesheet" href="WindowConfigurator__MasterStylesSheet.css">
    
    <!-- External Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bezier-js@2.1.0/dist/bezier.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/opentype.js@0.7.3/dist/opentype.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/makerjs@0/target/js/browser.maker.js"></script>


    <!-- CAD Generator - DXF Export Module -->
    <script src="WindowConfigurator__Feature__CadGeneration__DxfExportFunction.js"></script>

    <script>
        // =============================================================================
        // REGION | Global Configuration Constants - Single Source of Truth
        // =============================================================================
        // All configuration constants consolidated here for easy maintenance
        // and to prevent duplication across the codebase.
        // =============================================================================

        // -----------------------------------------------------------------------------
        // CAD / Window Configuration Constants
        // -----------------------------------------------------------------------------
        const CILL_HEIGHT        = 50;                                           // <-- Cill height (mm)
        const CILL_HORN_OVERHANG = 50;                                           // <-- Cill horn overhang each side (mm)
        const MIN_OPENING_WIDTH = 150;                                           // <-- Minimum opening width between mullions (mm)

        // -----------------------------------------------------------------------------
        // Dimension Annotation Constants
        // -----------------------------------------------------------------------------
        const DIM_OFFSET         = 100;                                          // <-- Dimension line offset from geometry (mm)
        const DIM_ARROW_SIZE     = 12;                                           // <-- Dimension arrow size (mm)
        const DIM_TEXT_SIZE      = 30;                                           // <-- Dimension text size in CAD units (mm) - NOTE: Not currently used
        const DIM_TEXT_FONT_SIZE = 12;                                           // <-- Dimension text font size in screen pixels
        const DIM_LAYER          = '00__Dimensions';                             // <-- Dimension layer name

        // -----------------------------------------------------------------------------
        // Viewport / Camera Constants
        // -----------------------------------------------------------------------------
        const VIEWPORT_ZOOM_INTENSITY = 0.001;                                   // <-- Mouse wheel zoom sensitivity
        const VIEWPORT_MIN_SCALE      = 0.01;                                    // <-- Minimum zoom out level
        const VIEWPORT_MAX_SCALE      = 50;                                      // <-- Maximum zoom in level
        const VIEWPORT_FIT_PADDING    = 0.7;                                     // <-- Padding when fitting view to model

        // -----------------------------------------------------------------------------
        // Color / Styling Constants
        // -----------------------------------------------------------------------------
        const COLOR_STROKE       = '#2c3e50';                                    // <-- Default geometry stroke color
        const COLOR_FILL         = 'none';                                       // <-- Default geometry fill
        const COLOR_FILL_DEFAULT = '#e8f5e9';                                    // <-- Default fill for Viewport module
        const COLOR_GROUND_LINE  = '#ff4444';                                    // <-- Ground reference line color
        const COLOR_AXIS_LINE    = '#00cc00';                                    // <-- Axis reference line color
        const COLOR_DIMENSION    = '#e74c3c';                                    // <-- Dimension lines and text color

        const STROKE_WIDTH          = 2;                                         // <-- Default stroke width
        const STROKE_WIDTH_CASEMENT = STROKE_WIDTH / 2;                          // <-- Casement stroke width (thinner)

        // endregion ===================================================================

        // =============================================================================
        // REGION | Script Configs
        // =============================================================================
        // UI configuration objects and viewport guides configuration
        // =============================================================================

        // -----------------------------------------------------------------------------
        // UI Configuration (JSON Config Header)
        // -----------------------------------------------------------------------------
        // INDEX: This config defines which UI elements are built
        // ┌────────────────────────────────────────────────────────────────────┐
        // │ INPUTS - Primary Row:                                              │
        // │   - windowWidth   : Window width in mm (600-4000)                  │
        // │   - windowHeight  : Window height in mm (400-3000)                 │
        // │   - mullions      : Number of mullions (vertical dividers) (0-6)   │
        // │   - hGlazeBars    : Horizontal glaze bars per opening (0-5)        │
        // │   - vGlazeBars    : Vertical glaze bars per opening (0-5)          │
        // │                                                                    │
        // │ INPUTS - Secondary Row:                                            │
        // │   - frameThickness : Main frame thickness (0-100mm)                │
        // │   - mullionWidth   : Mullion width (20-175mm)                      │
        // │   - glazeBarWidth  : Glaze bar width (10-50mm)                     │
        // │   - showCill       : Toggle for window cill                        │
        // │                                                                    │
        // │ BUTTONS:                                                           │
        // │   - reset-btn     : Resets view and opening widths to even        │
        // │   - dxf-btn       : Downloads DXF file                             │
        // └────────────────────────────────────────────────────────────────────┘
        const UI_CONFIG = {
            containerId:      'controls',
            statusBarId:      'status-bar',
            canvasWrapperId:  'canvas-wrapper',
            loadingText:      'Loading CAD Libraries...',
            
            inputs: [
                { id: 'windowWidth',  label: 'Width',     default: 1800, min: 600,  max: 4000, step: 50, unit: 'mm', onChange: 'onParamChange',   width: '140px' },
                { id: 'windowHeight', label: 'Height',    default: 1200, min: 400,  max: 3000, step: 50, unit: 'mm', onChange: 'onParamChange',   width: '140px' },
                { id: 'mullions',     label: 'Mullions',  default: 1,    min: 0,    max: 6,    step: 1,  unit: '',   onChange: 'onMullionChange', width: '100px' },
                { id: 'hGlazeBars',   label: 'H Bars',    default: 1,    min: 0,    max: 5,    step: 1,  unit: '',   onChange: 'onParamChange',   width: '90px'  },
                { id: 'vGlazeBars',   label: 'V Bars',    default: 1,    min: 0,    max: 5,    step: 1,  unit: '',   onChange: 'onParamChange',   width: '90px'  }
            ],
            
            buttons: [
                { id: 'reset-btn', label: 'Reset View',    action: 'onReset',       style: 'primary' },
                { id: 'dxf-btn',   label: 'Download DXF',  action: 'onDownloadDXF', style: 'success' }
            ]
        };

        // Secondary controls config (built manually for toggle support)
        const SECONDARY_CONFIG = {
            containerId: 'controls-secondary',
            inputs: [
                { id: 'frameThickness', label: 'Frame',      default: 50,  min: 0,   max: 100, step: 5,  unit: 'mm' },
                { id: 'mullionWidth',   label: 'Mullion',    default: 40,  min: 20,  max: 100, step: 5,  unit: 'mm' },
                { id: 'glazeBarWidth',  label: 'Glaze Bar',  default: 25,  min: 10,  max: 50,  step: 1,  unit: 'mm' }
            ],
            toggles: [
                { id: 'showCill', label: 'Window Cill', default: true },
                { id: 'showDimensions', label: 'Dimensions', default: true }
            ],
            casements: [
                { id: 'showCasements', label: 'Casements', default: false },
                { id: 'casementInset', label: 'Casement Inset', default: 65, min: 20, max: 150, step: 5, unit: 'mm', enabledBy: 'showCasements' }
            ]
        };

        // -----------------------------------------------------------------------------
        // Global State Variables
        // -----------------------------------------------------------------------------
        let currentModel     = null;                                             // <-- Current Maker.js model
        let frameworkOpeningWidths__BetweenMullions = [];                        // <-- Individual opening widths between mullions
        let dragState        = {                                                 // <-- Drag interaction state
            active:       false,
            mullionIndex: -1,
            startX:       0,
            startWidths:  []
        };

        let mullionDragListeners = {                                             // <-- Track event listeners for cleanup
            move: null,
            up:   null
        };

        // -----------------------------------------------------------------------------
        // Viewport Guides Configuration
        // -----------------------------------------------------------------------------
        const guidesConfig = {                                                   // <-- Viewport guides config
            showGround:  false,
            showAxis:    false,
            strokeColor: COLOR_STROKE,
            strokeWidth: STROKE_WIDTH,
            fillColor:   COLOR_FILL,
            layerOptions: {                                                      // <-- Layer-specific styling
                [DIM_LAYER]: { 
                    stroke: COLOR_DIMENSION,                                     // <-- Red dimension lines
                    fill:   COLOR_DIMENSION                                      // <-- Red dimension text
                }
            }
        };

        // endregion ===================================================================

        // =====================================================================
        // REGION | CadGenerator - Dynamic UI Module (INLINED)
        // =====================================================================
        (function() {
            'use strict';

            let _config = null;
            let _handlers = {};
            let _stylesInjected = false;
            let _containerEl = null;
            let _statusBarEl = null;
            let _canvasWrapperEl = null;
            let _inputElements = {};

            function injectStyles(customStyles = '') {
                if (_stylesInjected) return;
                // Only inject custom styles if provided (base styles are in external CSS)
                if (customStyles && customStyles.trim()) {
                    const styleEl = document.createElement('style');
                    styleEl.id = 'cad-generator-dynamic-ui-custom-styles';
                    styleEl.textContent = customStyles;
                    document.head.appendChild(styleEl);
                }
                _stylesInjected = true;
            }

            function build(config, handlers = {}) {
                _config = config;
                _handlers = handlers;
                _inputElements = {};

                injectStyles(config.styles?.custom || '');

                if (config.containerId) {
                    _containerEl = document.getElementById(config.containerId);
                    if (_containerEl) {
                        _containerEl.classList.add('cad-controls');
                        _containerEl.innerHTML = '';

                        if (config.inputs && Array.isArray(config.inputs)) {
                            for (const inputDef of config.inputs) {
                                const inputGroup = buildSliderInput(inputDef);
                                _containerEl.appendChild(inputGroup);
                            }
                        }

                        if (config.buttons && Array.isArray(config.buttons)) {
                            for (const btnDef of config.buttons) {
                                const btnGroup = buildButton(btnDef);
                                _containerEl.appendChild(btnGroup);
                            }
                        }
                    }
                }

                if (config.statusBarId) {
                    _statusBarEl = document.getElementById(config.statusBarId);
                    if (_statusBarEl) {
                        _statusBarEl.classList.add('cad-status-bar');
                    }
                }

                if (config.canvasWrapperId) {
                    _canvasWrapperEl = document.getElementById(config.canvasWrapperId);
                    if (_canvasWrapperEl) {
                        _canvasWrapperEl.classList.add('cad-canvas-wrapper');
                        if (config.loadingText) {
                            _canvasWrapperEl.innerHTML = `<span class="cad-loading-text">${config.loadingText}</span>`;
                        }
                    }
                }

                return true;
            }

            function buildSliderInput(def) {
                const group = document.createElement('div');
                group.classList.add('cad-input-group');
                
                if (def.width) {
                    group.style.minWidth = def.width;
                }

                const label = document.createElement('label');
                label.htmlFor = def.id;
                label.textContent = def.label || def.id;
                group.appendChild(label);

                const sliderContainer = document.createElement('div');
                sliderContainer.classList.add('cad-slider-container');

                const sliderRow = document.createElement('div');
                sliderRow.classList.add('cad-slider-row');

                const slider = document.createElement('input');
                slider.type = 'range';
                slider.id = def.id;
                slider.min = def.min !== undefined ? def.min : 0;
                slider.max = def.max !== undefined ? def.max : 100;
                slider.step = def.step !== undefined ? def.step : 1;
                slider.value = def.default !== undefined ? def.default : 50;

                const valueDisplay = document.createElement('div');
                valueDisplay.classList.add('cad-value-display');
                valueDisplay.dataset.inputId = def.id;
                updateValueDisplay(valueDisplay, slider.value, def.unit);

                _inputElements[def.id] = {
                    slider: slider,
                    valueDisplay: valueDisplay,
                    def: def
                };

                slider.addEventListener('input', () => {
                    updateValueDisplay(valueDisplay, slider.value, def.unit);
                    if (def.onChange && _handlers[def.onChange]) {
                        _handlers[def.onChange](def.id, parseFloat(slider.value));
                    }
                });

                valueDisplay.addEventListener('dblclick', () => {
                    showTextInput(def, slider, valueDisplay);
                });

                sliderRow.appendChild(slider);
                sliderRow.appendChild(valueDisplay);
                sliderContainer.appendChild(sliderRow);

                if (def.hint) {
                    const hint = document.createElement('span');
                    hint.classList.add('cad-hint');
                    hint.textContent = def.hint;
                    sliderContainer.appendChild(hint);
                }

                group.appendChild(sliderContainer);
                return group;
            }

            function updateValueDisplay(displayEl, value, unit) {
                const numValue = parseFloat(value);
                const formatted = Number.isInteger(numValue) ? numValue : numValue.toFixed(1);
                
                if (unit) {
                    displayEl.innerHTML = `${formatted}<span class="cad-unit">${unit}</span>`;
                } else {
                    displayEl.textContent = formatted;
                }
            }

            function showTextInput(def, slider, valueDisplay) {
                const textInput = document.createElement('input');
                textInput.type = 'number';
                textInput.classList.add('cad-value-input');
                textInput.min = def.min !== undefined ? def.min : '';
                textInput.max = def.max !== undefined ? def.max : '';
                textInput.step = def.step !== undefined ? def.step : 'any';
                textInput.value = slider.value;

                valueDisplay.style.display = 'none';
                valueDisplay.parentNode.insertBefore(textInput, valueDisplay.nextSibling);
                textInput.focus();
                textInput.select();

                const commitValue = () => {
                    let newValue = parseFloat(textInput.value);
                    
                    if (def.min !== undefined && newValue < def.min) newValue = def.min;
                    if (def.max !== undefined && newValue > def.max) newValue = def.max;
                    
                    if (isNaN(newValue)) {
                        newValue = def.default !== undefined ? def.default : def.min || 0;
                    }

                    slider.value = newValue;
                    updateValueDisplay(valueDisplay, newValue, def.unit);

                    textInput.remove();
                    valueDisplay.style.display = '';

                    if (def.onChange && _handlers[def.onChange]) {
                        _handlers[def.onChange](def.id, newValue);
                    }
                };

                textInput.addEventListener('blur', commitValue);
                textInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        textInput.blur();
                    }
                    if (e.key === 'Escape') {
                        textInput.value = slider.value;
                        textInput.blur();
                    }
                });
            }

            function buildButton(def) {
                const group = document.createElement('div');
                group.classList.add('cad-input-group');

                const btn = document.createElement('button');
                btn.id = def.id;
                btn.textContent = def.label || 'Button';
                btn.classList.add('cad-btn');

                const styleClass = `cad-btn--${def.style || 'primary'}`;
                btn.classList.add(styleClass);

                if (def.action && _handlers[def.action]) {
                    btn.addEventListener('click', _handlers[def.action]);
                } else if (def.action) {
                    btn.addEventListener('click', () => {
                        console.warn(`[DynamicUI] Handler "${def.action}" not found.`);
                    });
                }

                group.appendChild(btn);
                return group;
            }

            function getValue(inputId) {
                if (_inputElements[inputId]) {
                    return parseFloat(_inputElements[inputId].slider.value);
                }

                const el = document.getElementById(inputId);
                if (!el) return null;

                if (el.type === 'number' || el.type === 'range') {
                    return parseFloat(el.value);
                }
                if (el.type === 'checkbox') {
                    return el.checked;
                }
                return el.value;
            }

            function setValue(inputId, value) {
                if (_inputElements[inputId]) {
                    const { slider, valueDisplay, def } = _inputElements[inputId];
                    slider.value = value;
                    updateValueDisplay(valueDisplay, value, def.unit);
                    return true;
                }

                const el = document.getElementById(inputId);
                if (!el) return false;

                if (el.type === 'checkbox') {
                    el.checked = !!value;
                } else {
                    el.value = value;
                }
                return true;
            }

            function getAllValues() {
                if (!_config || !_config.inputs) return {};
                const values = {};
                for (const inputDef of _config.inputs) {
                    values[inputDef.id] = getValue(inputDef.id);
                }
                return values;
            }

            function setStatus(message) {
                if (_statusBarEl) {
                    _statusBarEl.textContent = message;
                }
            }

            function showLoading(show, message = 'Loading...') {
                if (!_canvasWrapperEl) return;

                if (show) {
                    let loadingEl = _canvasWrapperEl.querySelector('.cad-loading-text');
                    if (!loadingEl) {
                        loadingEl = document.createElement('span');
                        loadingEl.classList.add('cad-loading-text');
                        _canvasWrapperEl.appendChild(loadingEl);
                    }
                    loadingEl.textContent = message;
                    loadingEl.style.display = 'block';
                } else {
                    const loadingEl = _canvasWrapperEl.querySelector('.cad-loading-text');
                    if (loadingEl) {
                        loadingEl.style.display = 'none';
                    }
                }
            }

            function getConfig() {
                return _config;
            }

            function getContainer() {
                return _containerEl;
            }

            function getCanvasWrapper() {
                return _canvasWrapperEl;
            }

            function registerHandler(name, fn) {
                _handlers[name] = fn;
            }

            window.CadGenerator = window.CadGenerator || {};
            window.CadGenerator.DynamicUI = {
                build,
                getValue,
                setValue,
                getAllValues,
                setStatus,
                showLoading,
                getConfig,
                getContainer,
                getCanvasWrapper,
                registerHandler
            };
        })();
        // endregion ===============================================================
    </script>

    <script>
        // =====================================================================
        // REGION | CadGenerator - Viewport Module (INLINED - Unified UCS)
        // =====================================================================
        (function() {
            'use strict';

            const DEFAULT_CONFIG = {
                zoomIntensity: VIEWPORT_ZOOM_INTENSITY,
                minScale:      VIEWPORT_MIN_SCALE,
                maxScale:      VIEWPORT_MAX_SCALE,
                fitPadding:    VIEWPORT_FIT_PADDING,
                strokeColor:   COLOR_STROKE,
                strokeWidth:   STROKE_WIDTH,
                fillColor:     COLOR_FILL_DEFAULT,
                groundLineColor: COLOR_GROUND_LINE,
                axisLineColor: COLOR_AXIS_LINE,
                showGroundLine: true,
                showAxisLine:   true
            };

            let _wrapperId = null;
            let _wrapperEl = null;
            let _svgEl = null;
            let _currentModel = null;
            let _config = { ...DEFAULT_CONFIG };
            let _camState = { x: 0, y: 0, scale: 1 };
            let _isDragging = false;
            let _lastMouse = { x: 0, y: 0 };
            let _modelBounds = null;
            let _onRenderCallback = null;
            let _onCameraChangeCallback = null;                                      // <-- Camera change callback
            let _isInitialized = false;

            function getMakerJS() {
                if (window.makerjs) return window.makerjs;
                if (window.require) {
                    try { return window.require('makerjs'); } catch(e) {}
                }
                return null;
            }

            function init(wrapperId, options = {}) {
                _wrapperId = wrapperId;
                _wrapperEl = document.getElementById(wrapperId);
                
                if (!_wrapperEl) {
                    console.error(`[Viewport] Element with id "${wrapperId}" not found.`);
                    return false;
                }

                _config = { ...DEFAULT_CONFIG, ...options };

                _wrapperEl.style.overflow = 'hidden';
                _wrapperEl.style.position = 'relative';
                _wrapperEl.style.cursor = 'grab';
                _wrapperEl.style.userSelect = 'none';

                _camState = { x: 0, y: 0, scale: 1 };
                _isDragging = false;
                _isInitialized = false;

                return true;
            }

            function render(makerModel, guides = {}, options = {}) {
                const M = getMakerJS();
                if (!M) {
                    console.error('[Viewport] MakerJS library not loaded.');
                    return false;
                }

                if (!_wrapperEl) {
                    console.error('[Viewport] Viewport not initialized. Call init() first.');
                    return false;
                }

                const preserveCamera = options.preserveCamera === true;
                const savedCamState = preserveCamera ? { ..._camState } : null;

                _currentModel = makerModel;

                const measure = M.measure.modelExtents(makerModel);
                _modelBounds = measure;

                const modelSVG = M.exporter.toSVG(makerModel, { useSvgPathOnly: true });

                let guidesHTML = '';
                
                if (_config.showGroundLine && guides.showGround !== false) {
                    guidesHTML += `<line x1="-20000" y1="0" x2="20000" y2="0" 
                        stroke="${_config.groundLineColor}" stroke-width="2" 
                        vector-effect="non-scaling-stroke" />`;
                }

                if (_config.showAxisLine && guides.showAxis !== false) {
                    const axisExtent = guides.axisHeight || 20000;
                    guidesHTML += `<line x1="0" y1="-${axisExtent}" x2="0" y2="${axisExtent}" 
                        stroke="${_config.axisLineColor}" stroke-width="2" 
                        stroke-dasharray="10,5" vector-effect="non-scaling-stroke" />`;
                }

                if (guides.custom && Array.isArray(guides.custom)) {
                    for (const g of guides.custom) {
                        guidesHTML += g;
                    }
                }

                const stroke = guides.strokeColor || _config.strokeColor;
                const strokeW = guides.strokeWidth || _config.strokeWidth;
                const fill = guides.fillColor || _config.fillColor;

                // SVG structure with Y-flip for CAD to screen coordinate conversion
                // flip-group inverts Y-axis (Maker.js Y+ UP -> SVG Y+ DOWN)
                // dim-caption-group is OUTSIDE flip-group with counter Y-flip so text stays right-side-up
                const svgHTML = `
                <svg id="cad-viewport-svg" width="100%" height="100%" style="display:block;">
                    <g id="camera-group">
                        <g id="flip-group" transform="scale(1, -1)">
                            <g id="guides-group">
                                ${guidesHTML}
                            </g>
                            <g id="geometry-group" stroke="${stroke}" stroke-width="${strokeW}" fill="${fill}">
                                ${modelSVG}
                            </g>
                        </g>
                        <g id="dim-caption-group" transform="scale(1, -1)"></g>
                    </g>
                </svg>`;

                _wrapperEl.innerHTML = svgHTML;
                
                _svgEl = document.getElementById('cad-viewport-svg');
                setupInteraction(_svgEl);

                if (preserveCamera && savedCamState) {
                    _camState = savedCamState;
                } else if (!_isInitialized) {
                    _camState = { x: 0, y: 0, scale: 1 };
                }

                updateCameraTransform();
                _isInitialized = true;

                if (_onRenderCallback) {
                    _onRenderCallback(_currentModel, _modelBounds);
                }

                return true;
            }

            function renderSimple(makerModel, options = {}) {
                const M = getMakerJS();
                if (!M || !_wrapperEl) return false;

                _currentModel = makerModel;
                _modelBounds = M.measure.modelExtents(makerModel);

                const renderOptions = {
                    svgAttrs: options.svgAttrs || {},
                    stroke: options.stroke || _config.strokeColor,
                    strokeWidth: options.strokeWidth || `${_config.strokeWidth}px`,
                    fill: options.fill || _config.fillColor
                };

                const svg = M.exporter.toSVG(makerModel, renderOptions);
                _wrapperEl.innerHTML = svg;

                return true;
            }

            function setupInteraction(svgEl) {
                if (!svgEl) return;

                svgEl.addEventListener('wheel', handleWheel, { passive: false });
                svgEl.addEventListener('mousedown', handleMouseDown);
                window.addEventListener('mousemove', handleMouseMove);
                window.addEventListener('mouseup', handleMouseUp);
            }

            function handleWheel(e) {
                e.preventDefault();
                
                const delta = e.deltaY;
                const scaleFactor = 1 - delta * _config.zoomIntensity;

                const rect = _wrapperEl.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;

                const worldX = (mouseX - _camState.x) / _camState.scale;
                const worldY = (mouseY - _camState.y) / _camState.scale;

                _camState.scale *= scaleFactor;
                _camState.scale = Math.max(_config.minScale, Math.min(_config.maxScale, _camState.scale));

                _camState.x = mouseX - worldX * _camState.scale;
                _camState.y = mouseY - worldY * _camState.scale;

                updateCameraTransform();
            }

            function handleMouseDown(e) {
                // Don't pan if clicking on a mullion handle
                if (e.target.classList.contains('mullion-handle')) {
                    return;
                }
                
                if (e.button === 0 || e.button === 1) {
                    _isDragging = true;
                    _lastMouse = { x: e.clientX, y: e.clientY };
                    document.body.style.cursor = 'grabbing';
                }
            }

            function handleMouseMove(e) {
                if (!_isDragging) return;

                const dx = e.clientX - _lastMouse.x;
                const dy = e.clientY - _lastMouse.y;
                _lastMouse = { x: e.clientX, y: e.clientY };

                _camState.x += dx;
                _camState.y += dy;
                updateCameraTransform();
            }

            function handleMouseUp() {
                _isDragging = false;
                document.body.style.cursor = '';
            }

            function updateCameraTransform() {
                const g = document.getElementById('camera-group');
                if (g) {
                    // Apply Y-flip to camera view (negative scale on Y-axis)
                    g.setAttribute('transform', `translate(${_camState.x}, ${_camState.y}) scale(${_camState.scale}, ${-_camState.scale})`);
                }
                
                // Notify listeners of camera change
                if (_onCameraChangeCallback) {
                    _onCameraChangeCallback({ ..._camState });
                }
            }

            function getState() {
                return { ..._camState };
            }

            function setState(newState) {
                _camState = { ..._camState, ...newState };
                updateCameraTransform();
            }

            function getModel() {
                return _currentModel;
            }

            function getBounds() {
                return _modelBounds;
            }

            function onRender(callback) {
                _onRenderCallback = callback;
            }

            function onCameraChange(callback) {
                _onCameraChangeCallback = callback;
            }

            function getConfig() {
                return { ..._config };
            }

            function setConfig(newConfig) {
                _config = { ..._config, ...newConfig };
            }

            function isInitialized() {
                return _isInitialized;
            }

            window.CadGenerator = window.CadGenerator || {};
            window.CadGenerator.Viewport = {
                init,
                render,
                renderSimple,
                getState,
                setState,
                getModel,
                getBounds,
                getConfig,
                setConfig,
                onRender,
                onCameraChange,                                                      // <-- Camera change callback
                getMakerJS,
                isInitialized
            };
        })();
        // endregion ===============================================================
    </script>


</head>
<body>

    <h1>Window Configurator</h1>
    <p class="subtitle">Drag sliders for real-time preview. Double-click values for precise input. Drag mullions to resize openings.</p>

    <!-- Control Panel (Built by DynamicUI) -->
    <div id="controls"></div>

    <!-- Secondary Controls Row -->
    <div id="controls-secondary" class="controls-row"></div>

    <!-- Canvas Wrapper (Managed by Viewport) -->
    <div id="canvas-wrapper"></div>
    
    <!-- Status Bar -->
    <div id="status-bar">Initializing...</div>

    <!-- Drag Feedback Tooltip -->
    <div id="drag-feedback" class="drag-feedback"></div>

    <script>
        // =============================================================================
        // REGION | Global Helper Functions
        // =============================================================================
        // Parameter getters, dimension scaling helpers, and mullion management
        // =============================================================================

        // -----------------------------------------------------------------------------
        // Parameter Getters
        // -----------------------------------------------------------------------------

        // FUNCTION | Get current frame thickness from slider
        // ------------------------------------------------------------
        function getFrameThickness() {
            const el = document.getElementById('frameThickness');
            return el ? parseInt(el.value) : 50;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get current mullion width from slider
        // ------------------------------------------------------------
        function getMullionWidth() {
            const el = document.getElementById('mullionWidth');
            return el ? parseInt(el.value) : 65;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get current glaze bar width from slider
        // ------------------------------------------------------------
        function getGlazeBarWidth() {
            const el = document.getElementById('glazeBarWidth');
            return el ? parseInt(el.value) : 25;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get cill toggle state
        // ------------------------------------------------------------
        function getShowCill() {
            const el = document.getElementById('showCill');
            return el ? el.checked : true;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get dimensions toggle state
        // ------------------------------------------------------------
        function getShowDimensions() {
            const el = document.getElementById('showDimensions');
            return el ? el.checked : true;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get casements toggle state
        // ------------------------------------------------------------
        function getShowCasements() {
            const el = document.getElementById('showCasements');
            return el ? el.checked : false;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get casement inset depth from slider
        // ------------------------------------------------------------
        function getCasementInset() {
            const el = document.getElementById('casementInset');
            return el ? parseInt(el.value) : 65;
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Dimension Scaling Helpers
        // -----------------------------------------------------------------------------

        // FUNCTION | Get scaled font size for dimension text
        // ------------------------------------------------------------
        // Returns font size as percentage of window height (counter-scaled for zoom)
        // ------------------------------------------------------------
        function getDimensionFontSize(camState) {
            const UI = window.CadGenerator.DynamicUI;
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            
            // Font size = 3% of window height (adjust percentage to tune)
            const fontSize = (windowHeight * 0.03) / camState.scale;
            return fontSize;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get scaled arrow size for dimension lines
        // ------------------------------------------------------------
        function getDimensionArrowSize() {
            const UI = window.CadGenerator.DynamicUI;
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            
            // Arrow size = 2.5% of window height
            return windowHeight * 0.025;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get scaled handle padding for mullion drag handles
        // ------------------------------------------------------------
        function getHandlePadding() {
            const UI = window.CadGenerator.DynamicUI;
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            
            // Handle padding = 4% of window height
            return windowHeight * 0.04;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get scaled dimension offset (distance from model)
        // ------------------------------------------------------------
        function getDimensionOffset() {
            const UI = window.CadGenerator.DynamicUI;
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            
            // Offset = 15% of window height
            return windowHeight * 0.15;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get scaled witness line length
        // ------------------------------------------------------------
        function getWitnessLength() {
            const offset = getDimensionOffset();
            return offset / 2.5;
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Mullion Opening Width Management
        // -----------------------------------------------------------------------------

        // FUNCTION | Initialize opening widths between mullions to even distribution
        // ------------------------------------------------------------
        function initMullionOpeningWidths() {
            const UI           = window.CadGenerator.DynamicUI;
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const numMullions  = parseInt(UI.getValue('mullions'));
            const frameThick   = getFrameThickness();
            const mullionW     = getMullionWidth();
            
            const innerWidth        = windowWidth - (frameThick * 2);
            const numOpenings       = numMullions + 1;  // <-- Number of openings = mullions + 1
            const totalMullionWidth = numMullions * mullionW;  // <-- Total width of all mullions
            const availableWidth    = innerWidth - totalMullionWidth;
            const evenWidth         = availableWidth / numOpenings;
            
            frameworkOpeningWidths__BetweenMullions = Array(numOpenings).fill(evenWidth);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Validate and normalize opening widths between mullions
        // ------------------------------------------------------------
        function normalizeMullionOpeningWidths() {
            const UI           = window.CadGenerator.DynamicUI;
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const numMullions  = parseInt(UI.getValue('mullions'));
            const frameThick   = getFrameThickness();
            const mullionW     = getMullionWidth();
            
            const innerWidth        = windowWidth - (frameThick * 2);
            const numOpenings       = numMullions + 1;  // <-- Number of openings = mullions + 1
            const totalMullionWidth = numMullions * mullionW;  // <-- Total width of all mullions
            const availableWidth    = innerWidth - totalMullionWidth;
            
            // Ensure array length matches opening count
            if (frameworkOpeningWidths__BetweenMullions.length !== numOpenings) {
                initMullionOpeningWidths();
                return;
            }
            
            // Enforce minimum widths
            for (let i = 0; i < frameworkOpeningWidths__BetweenMullions.length; i++) {
                if (frameworkOpeningWidths__BetweenMullions[i] < MIN_OPENING_WIDTH) {
                    frameworkOpeningWidths__BetweenMullions[i] = MIN_OPENING_WIDTH;
                }
            }
            
            // Normalize to fit available width
            const currentTotal = frameworkOpeningWidths__BetweenMullions.reduce((a, b) => a + b, 0);
            if (Math.abs(currentTotal - availableWidth) > 0.1) {
                const scale = availableWidth / currentTotal;
                frameworkOpeningWidths__BetweenMullions = frameworkOpeningWidths__BetweenMullions.map(w => w * scale);
            }
        }
        // ---------------------------------------------------------------
        // endregion ===================================================================

        // =============================================================================
        // REGION | Math Functions
        // =============================================================================
        // Reserved for pure math/utility functions (currently empty)
        // =============================================================================
        // endregion ===================================================================

        // =============================================================================
        // REGION | CAD Functions
        // =============================================================================
        // All CAD model generation functions
        // =============================================================================

        // -----------------------------------------------------------------------------
        // Main Model Generation
        // -----------------------------------------------------------------------------

        // FUNCTION | Generate complete window model
        // ------------------------------------------------------------
        function generateWindow(M) {
            const UI = window.CadGenerator.DynamicUI;

            // Get parameters
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            const numMullions  = parseInt(UI.getValue('mullions'));
            const numOpenings  = numMullions + 1;  // <-- Number of openings = mullions + 1
            const hGlazeBars   = parseInt(UI.getValue('hGlazeBars'));
            const vGlazeBars   = parseInt(UI.getValue('vGlazeBars'));
            const frameThick   = getFrameThickness();
            const showCill     = getShowCill();

            // Model container
            const windowModel = { 
                models: {},
                paths: {},
                units: M.unitType.Millimeter 
            };

            // 1. Create outer frame (if thickness > 0)
            if (frameThick > 0) {
                windowModel.models.frameworkOuterWindowFrame = createFrameworkOuterWindowFrame(M, windowWidth, windowHeight, frameThick);
            } else {
                // Just outer rectangle when no frame
                windowModel.models.outerRect = {
                    models: { rect: new M.models.Rectangle(windowWidth, windowHeight) }
                };
            }

            // 2. Create openings separated by mullions
            const openingModels = createFrameworkOpenings__BetweenMullions(M, windowWidth, windowHeight, numOpenings, numMullions, frameThick);
            Object.assign(windowModel.models, openingModels);

            // 2.5. Add casements to openings if enabled
            if (getShowCasements()) {
                const casementInset = getCasementInset();
                createFrameworkCasements__WithinAllOpenings(M, windowModel, windowHeight, casementInset, frameThick);
            }

            // 3. Add glaze bars to each opening
            createFrameworkGlazeBars__WithinOpenings(M, windowModel, windowHeight, hGlazeBars, vGlazeBars, frameThick);

            // 4. Add window cill if enabled
            if (showCill) {
                windowModel.models.cill = createWindowCill(M, windowWidth, windowHeight);
            }

            // 5. Create dimension annotations (if enabled)
            if (getShowDimensions()) {
                createDimensions(M, windowModel, windowWidth, windowHeight, numOpenings, numMullions, frameThick, showCill);
            }

            return windowModel;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Download DXF file
        // ------------------------------------------------------------
        function downloadDXF() {
            const DxfExport = window.CadGenerator.DxfExport;
            DxfExport.download(currentModel, 'Window', {
                layerOptions: {
                    '00__Dimensions': { color: 1 }                               // <-- Red (AutoCAD color code 1)
                }
            });
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Frame Generation
        // -----------------------------------------------------------------------------

        // FUNCTION | Create outer window frame (double rectangle)
        // ------------------------------------------------------------
        function createFrameworkOuterWindowFrame(M, width, height, frameThick) {
            return {
                models: {
                    outer: new M.models.Rectangle(width, height),
                    inner: {
                        models: {
                            rect: new M.models.Rectangle(
                                width - (frameThick * 2),
                                height - (frameThick * 2)
                            )
                        },
                        origin: [frameThick, frameThick]
                    }
                }
            };
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create window cill (at bottom of window in CAD space)
        // CAD space: Y=0 is window bottom, negative Y is below window
        // After Y-flip: negative Y appears at bottom of screen
        // ------------------------------------------------------------
        function createWindowCill(M, windowWidth, windowHeight) {
            const cillWidth = windowWidth + (CILL_HORN_OVERHANG * 2);
            const cillX     = -CILL_HORN_OVERHANG;
            const cillY     = -CILL_HEIGHT;  // <-- Below window (negative Y in CAD)

            return {
                models: {
                    rect: new M.models.Rectangle(cillWidth, CILL_HEIGHT)
                },
                origin: [cillX, cillY]
            };
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Pane/Opening Generation
        // -----------------------------------------------------------------------------

        // FUNCTION | Create window panes/openings separated by mullions
        // ------------------------------------------------------------
        function createFrameworkOpenings__BetweenMullions(M, width, height, numOpenings, numMullions, frameThick) {
            const openings    = {};
            const innerHeight = height - (frameThick * 2);
            const mullionW    = getMullionWidth();
            
            let xOffset = frameThick;

            for (let i = 0; i < numOpenings; i++) {
                const openingWidth = frameworkOpeningWidths__BetweenMullions[i];
                
                // Create opening frame
                openings[`opening_${i}`] = {
                    models: {
                        frame: new M.models.Rectangle(openingWidth, innerHeight)
                    },
                    origin: [xOffset, frameThick]
                };

                // Store opening data for drag handles
                openings[`opening_${i}`]._data = {
                    index: i,
                    x: xOffset,
                    width: openingWidth
                };

                xOffset += openingWidth;

                // Add mullion (except after last opening)
                if (i < numOpenings - 1) {
                    openings[`mullion_${i}`] = {
                        models: {
                            rect: new M.models.Rectangle(mullionW, innerHeight)
                        },
                        origin: [xOffset, frameThick],
                        _data: {
                            index: i,
                            x: xOffset
                        }
                    };
                    xOffset += mullionW;
                }
            }

            return openings;
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Casement Frame Generation
        // -----------------------------------------------------------------------------

        // FUNCTION | Create casement frames within all openings
        // ------------------------------------------------------------
        function createFrameworkCasements__WithinAllOpenings(M, windowModel, windowHeight, casementInset, frameThick) {
            const innerHeight = windowHeight - (frameThick * 2);                 // <-- Opening height
            
            // Iterate through all openings and add casements
            for (let i = 0; i < frameworkOpeningWidths__BetweenMullions.length; i++) {
                const openingKey   = `opening_${i}`;
                const opening      = windowModel.models[openingKey];
                
                if (!opening) continue;
                
                const openingWidth = frameworkOpeningWidths__BetweenMullions[i];
                
                // Create casement frame for this opening
                opening.models.casement = createFrameworkCasement__SingleOpening(
                    M, 
                    openingWidth, 
                    innerHeight, 
                    casementInset
                );
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create single casement frame within one opening
        // ------------------------------------------------------------
        function createFrameworkCasement__SingleOpening(M, openingWidth, openingHeight, casementInset) {
            // Calculate inset dimensions (casement sits inside opening by inset amount)
            const casementWidth  = openingWidth - (casementInset * 2);           // <-- Inset from both sides
            const casementHeight = openingHeight - (casementInset * 2);          // <-- Inset from top and bottom
            
            return {
                models: {
                    rect: new M.models.Rectangle(casementWidth, casementHeight)
                },
                origin: [casementInset, casementInset],                          // <-- Position at inset offset
                layer: 'casements'                                                // <-- Layer for thinner stroke
            };
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Glaze Bar Generation
        // -----------------------------------------------------------------------------

        // FUNCTION | Create glaze bars within all panes/openings
        // ------------------------------------------------------------
        function createFrameworkGlazeBars__WithinOpenings(M, windowModel, windowHeight, hBars, vBars, frameThick) {
            const innerHeight   = windowHeight - (frameThick * 2);
            const glazeBarWidth = getGlazeBarWidth();
            
            // Get casement inset (0 if casements disabled)
            const casementInset = getShowCasements() ? getCasementInset() : 0;   // <-- Casement adjustment

            for (let i = 0; i < frameworkOpeningWidths__BetweenMullions.length; i++) {
                const openingKey = `opening_${i}`;
                const opening    = windowModel.models[openingKey];
                
                if (!opening) continue;

                const openingWidth = frameworkOpeningWidths__BetweenMullions[i];
                
                // Calculate adjusted dimensions (shorter by casement insets on both ends)
                const adjustedOpeningWidth  = openingWidth - (casementInset * 2);    // <-- Shorter width
                const adjustedInnerHeight   = innerHeight - (casementInset * 2);     // <-- Shorter height

                // Add horizontal glaze bars
                if (hBars > 0) {
                    const hSpacing = adjustedInnerHeight / (hBars + 1);
                    for (let h = 0; h < hBars; h++) {
                        const yPos = (hSpacing * (h + 1)) + casementInset;          // <-- Offset by casement
                        opening.models[`hBar_${h}`] = {
                            models: {
                                rect: new M.models.Rectangle(adjustedOpeningWidth, glazeBarWidth)
                            },
                            origin: [casementInset, yPos - (glazeBarWidth / 2)]     // <-- Offset by casement
                        };
                    }
                }

                // Add vertical glaze bars
                if (vBars > 0) {
                    const vSpacing = adjustedOpeningWidth / (vBars + 1);
                    for (let v = 0; v < vBars; v++) {
                        const xPos = (vSpacing * (v + 1)) + casementInset;          // <-- Offset by casement
                        opening.models[`vBar_${v}`] = {
                            models: {
                                rect: new M.models.Rectangle(glazeBarWidth, adjustedInnerHeight)
                            },
                            origin: [xPos - (glazeBarWidth / 2), casementInset]     // <-- Offset by casement
                        };
                    }
                }
            }
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Dimension Annotations (Layer: 00__Dimensions)
        // -----------------------------------------------------------------------------

        // FUNCTION | Create all dimension annotations (CAD space with Y-flip)
        // ------------------------------------------------------------
        // In CAD space: Y=0 is window bottom, Y=height is window top
        // Cill is at negative Y (below window)
        // After Y-flip: high CAD Y appears at top of screen, low CAD Y at bottom
        // ------------------------------------------------------------
        function createDimensions(M, windowModel, width, height, numOpenings, numMullions, frameThick, showCill) {
            const dimOffset = getDimensionOffset();  // <-- Scaled offset
            const cillOffset = showCill ? CILL_HEIGHT + 20 : 0;

            // Overall width dimension (above window - high Y in CAD = top of screen after flip)
            windowModel.models.dimOverallWidth = createHorizontalDimension(M, 
                [0, height + dimOffset], 
                [width, height + dimOffset],
                `${width}`
            );

            // Overall height dimension (right side)
            windowModel.models.dimOverallHeight = createVerticalDimension(M, 
                [width + dimOffset, 0], 
                [width + dimOffset, height],
                `${height}`
            );

            // Opening width dimensions (below window/cill - negative Y in CAD = bottom of screen)
            const dimY = -(cillOffset + dimOffset);
            let xOffset = frameThick;
            const mullionW = getMullionWidth();

            for (let i = 0; i < numOpenings; i++) {
                const openingWidth = Math.round(frameworkOpeningWidths__BetweenMullions[i]);
                
                windowModel.models[`dimOpening_${i}`] = createHorizontalDimension(M,
                    [xOffset, dimY],
                    [xOffset + frameworkOpeningWidths__BetweenMullions[i], dimY],
                    `${openingWidth}`
                );

                xOffset += frameworkOpeningWidths__BetweenMullions[i];
                if (i < numOpenings - 1) {
                    xOffset += mullionW;
                }
            }

            // Cill dimensions if shown (below cill - more negative Y)
            if (showCill) {
                const cillWidth = width + (CILL_HORN_OVERHANG * 2);
                const cillDimY = -(CILL_HEIGHT + dimOffset * 0.4);  // <-- Scaled spacing
                windowModel.models.dimCillWidth = createHorizontalDimension(M,
                    [-CILL_HORN_OVERHANG, cillDimY],
                    [width + CILL_HORN_OVERHANG, cillDimY],
                    `${cillWidth}`
                );
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create horizontal dimension line with caption
        // ------------------------------------------------------------
        function createHorizontalDimension(M, start, end, text) {
            const y = start[1];
            const midX = (start[0] + end[0]) / 2;
            const witnessLength = getWitnessLength();  // <-- Scaled witness line length
            const arrowSize = getDimensionArrowSize();  // <-- Scaled arrow size

            const dimModel = {
                paths: {
                    line: new M.paths.Line(start, end),
                    witnessStart: new M.paths.Line(
                        [start[0], y - witnessLength],
                        [start[0], y + witnessLength]
                    ),
                    witnessEnd: new M.paths.Line(
                        [end[0], y - witnessLength],
                        [end[0], y + witnessLength]
                    ),
                    arrowL1: new M.paths.Line(start, [start[0] + arrowSize, y + arrowSize / 2.5]),
                    arrowL2: new M.paths.Line(start, [start[0] + arrowSize, y - arrowSize / 2.5]),
                    arrowR1: new M.paths.Line(end, [end[0] - arrowSize, y + arrowSize / 2.5]),
                    arrowR2: new M.paths.Line(end, [end[0] - arrowSize, y - arrowSize / 2.5])
                },
                layer: DIM_LAYER
            };

            // Add caption using direct property assignment (degenerate anchor = horizontal text)
            dimModel.caption = {
                text: text,
                anchor: new M.paths.Line([midX, y], [midX, y])
            };

            return dimModel;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create vertical dimension line with caption
        // ------------------------------------------------------------
        function createVerticalDimension(M, start, end, text) {
            const x = start[0];
            const midY = (start[1] + end[1]) / 2;
            const witnessLength = getWitnessLength();  // <-- Scaled witness line length
            const arrowSize = getDimensionArrowSize();  // <-- Scaled arrow size

            const dimModel = {
                paths: {
                    line: new M.paths.Line(start, end),
                    witnessStart: new M.paths.Line(
                        [x - witnessLength, start[1]],
                        [x + witnessLength, start[1]]
                    ),
                    witnessEnd: new M.paths.Line(
                        [x - witnessLength, end[1]],
                        [x + witnessLength, end[1]]
                    ),
                    arrowB1: new M.paths.Line(start, [x + arrowSize / 2.5, start[1] + arrowSize]),
                    arrowB2: new M.paths.Line(start, [x - arrowSize / 2.5, start[1] + arrowSize]),
                    arrowT1: new M.paths.Line(end, [x + arrowSize / 2.5, end[1] - arrowSize]),
                    arrowT2: new M.paths.Line(end, [x - arrowSize / 2.5, end[1] - arrowSize])
                },
                layer: DIM_LAYER
            };

            // Add caption using direct property assignment (vertical anchor for rotated text)
            dimModel.caption = {
                text: text,
                anchor: new M.paths.Line([x, start[1]], [x, end[1]])
            };

            return dimModel;
        }
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Rendering Helpers
        // -----------------------------------------------------------------------------

        // FUNCTION | Render dimension text labels at dimension line midpoints
        // ------------------------------------------------------------
        // Text is rendered in dim-caption-group (inside camera-group but outside flip-group)
        // Uses model coordinates - camera transform handles scaling
        // Font size counter-scales to stay readable at any zoom level
        // This function is IDEMPOTENT - safe to call multiple times
        // NOTE: dim-caption-group is created by Viewport.render(), this function only clears/repopulates
        // ------------------------------------------------------------
        function renderDimensionCaptions() {
            // Early exit if dimensions are disabled
            if (!getShowDimensions()) {
                // Clear existing captions when disabled
                const existingGroup = document.getElementById('dim-caption-group');
                if (existingGroup) existingGroup.innerHTML = '';
                return;
            }

            const Viewport    = window.CadGenerator.Viewport;
            const svg         = document.getElementById('cad-viewport-svg');
            const cameraGroup = document.getElementById('camera-group');
            
            // Validate required DOM elements exist
            if (!svg || !cameraGroup || !currentModel) {
                return;
            }

            const camState = Viewport.getState();

            // Get text group (should already exist from Viewport.render())
            let textGroup = cameraGroup.querySelector('#dim-caption-group');
            if (!textGroup) {
                // Fallback: create if somehow missing (shouldn't happen)
                textGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                textGroup.id = 'dim-caption-group';
                textGroup.setAttribute('transform', 'scale(1, -1)');  // <-- Counter Y-flip
                cameraGroup.appendChild(textGroup);
            }
            textGroup.innerHTML = '';  // <-- Clear for idempotent re-render

            // Get scaled font size (proportional to window size, counter-scaled for zoom)
            const fontSize = getDimensionFontSize(camState);
            let dimCount = 0;

            // Render text for a dimension model at its midpoint
            function renderDimensionText(dimKey, model) {
                if (!model || !model.caption || !model.caption.anchor) return;
                
                const anchor = model.caption.anchor;
                const origin = model.origin || [0, 0];
                
                // Get midpoint in model coordinates (CAD space, Y+ up)
                const midX = (anchor.origin[0] + anchor.end[0]) / 2 + origin[0];
                const midY = (anchor.origin[1] + anchor.end[1]) / 2 + origin[1];
                
                // Use model coordinates directly - camera-group transform handles scaling
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('class', 'dim-caption');
                text.setAttribute('x', midX);
                text.setAttribute('y', midY);
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('dominant-baseline', 'middle');
                text.setAttribute('font-family', 'Segoe UI, sans-serif');
                text.setAttribute('font-size', fontSize);                             // <-- Counter-scaled
                text.setAttribute('font-weight', '600');
                text.setAttribute('fill', COLOR_DIMENSION);
                text.textContent = model.caption.text;
                
                // Rotate vertical dimensions for readability
                const dx = anchor.end[0] - anchor.origin[0];
                const dy = anchor.end[1] - anchor.origin[1];
                const isVertical = Math.abs(dx) < 0.01 && Math.abs(dy) > 0.01;
                
                if (isVertical) {
                    text.setAttribute('transform', `rotate(-90, ${midX}, ${midY})`);
                }
                
                textGroup.appendChild(text);
                dimCount++;
            }

            // Process all dimension models (keys starting with 'dim')
            if (currentModel.models) {
                for (const key in currentModel.models) {
                    if (key.startsWith('dim')) {
                        renderDimensionText(key, currentModel.models[key]);
                    }
                }
            }

            console.log(`[DimCaptions] Rendered ${dimCount} dimensions at scale ${camState.scale.toFixed(4)}`);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Apply layer-specific styling to SVG paths
        // ------------------------------------------------------------
        // Dimension lines need to be red but Viewport applies uniform stroke.
        // Casement lines need to be thinner than standard frames.
        // This post-processes the SVG to apply layer-specific colors and stroke widths.
        // ------------------------------------------------------------
        function applyLayerStyles() {
            const svg = document.getElementById('cad-viewport-svg');
            if (!svg) return;
            
            const geometryGroup = svg.querySelector('#geometry-group');
            if (!geometryGroup) return;
            
            // MakerJS exports paths with layer info in path IDs or parent group IDs
            // Find all paths and apply dimension color to dimension layer elements
            const allPaths = geometryGroup.querySelectorAll('path');
            allPaths.forEach(path => {
                const pathId = path.getAttribute('id') || '';
                const parentId = path.parentElement?.getAttribute('id') || '';
                
                // Check if path belongs to dimension layer or has dimension-related naming
                if (pathId.includes(DIM_LAYER) || 
                    parentId.includes(DIM_LAYER) ||
                    pathId.includes('dimOverall') || 
                    pathId.includes('dimOpening') || 
                    pathId.includes('dimCill')) {
                    path.setAttribute('stroke', COLOR_DIMENSION);                // <-- Dimension color
                }
                
                // Check if path belongs to casements layer (thinner stroke)
                if (pathId.includes('casements') || 
                    parentId.includes('casements') ||
                    pathId.includes('casement')) {
                    path.setAttribute('stroke-width', STROKE_WIDTH_CASEMENT);   // <-- Thinner stroke
                }
            });
            
            // Also check for groups that may contain dimension or casement paths
            const allGroups = geometryGroup.querySelectorAll('g');
            allGroups.forEach(group => {
                const groupId = group.getAttribute('id') || '';
                
                // Apply dimension color to dimension groups
                if (groupId.includes(DIM_LAYER) || 
                    groupId.includes('dimOverall') || 
                    groupId.includes('dimOpening') || 
                    groupId.includes('dimCill')) {
                    const childPaths = group.querySelectorAll('path');
                    childPaths.forEach(path => {
                        path.setAttribute('stroke', COLOR_DIMENSION);            // <-- Dimension color
                    });
                }
                
                // Apply thinner stroke to casement groups
                if (groupId.includes('casements') || groupId.includes('casement')) {
                    const childPaths = group.querySelectorAll('path');
                    childPaths.forEach(path => {
                        path.setAttribute('stroke-width', STROKE_WIDTH_CASEMENT); // <-- Thinner stroke
                    });
                }
            });
        }
        // ---------------------------------------------------------------
        // endregion ===================================================================

        // =============================================================================
        // REGION | UI Functions
        // =============================================================================
        // UI building and management functions
        // =============================================================================

        // -----------------------------------------------------------------------------
        // Secondary UI Builder
        // -----------------------------------------------------------------------------

        // FUNCTION | Build secondary controls with toggles
        // ------------------------------------------------------------
        function buildSecondaryControls() {
            const container = document.getElementById(SECONDARY_CONFIG.containerId);
            if (!container) return;

            container.innerHTML = '';

            // Build slider inputs section
            const slidersSection = document.createElement('div');
            slidersSection.className = 'controls-section';
            
            const slidersTitle = document.createElement('div');
            slidersTitle.className = 'controls-section-title';
            slidersTitle.textContent = 'Frame Dimensions';
            slidersSection.appendChild(slidersTitle);

            const slidersRow = document.createElement('div');
            slidersRow.style.display = 'flex';
            slidersRow.style.gap = '15px';

            for (const input of SECONDARY_CONFIG.inputs) {
                const group = createSliderGroup(input);
                slidersRow.appendChild(group);
            }
            slidersSection.appendChild(slidersRow);
            container.appendChild(slidersSection);

            // Build toggles section
            const togglesSection = document.createElement('div');
            togglesSection.className = 'controls-section';
            
            const togglesTitle = document.createElement('div');
            togglesTitle.className = 'controls-section-title';
            togglesTitle.textContent = 'Options';
            togglesSection.appendChild(togglesTitle);

            for (const toggle of SECONDARY_CONFIG.toggles) {
                const toggleGroup = createToggleGroup(toggle);
                togglesSection.appendChild(toggleGroup);
            }
            container.appendChild(togglesSection);

            // Build casements section
            if (SECONDARY_CONFIG.casements) {
                const casementsSection = document.createElement('div');
                casementsSection.className = 'controls-section';
                
                const casementsTitle = document.createElement('div');
                casementsTitle.className = 'controls-section-title';
                casementsTitle.textContent = 'Casements';
                casementsSection.appendChild(casementsTitle);

                let casementsToggleCheckbox = null;

                for (const item of SECONDARY_CONFIG.casements) {
                    // First item is toggle, rest are sliders
                    if (item.id === 'showCasements') {
                        const toggleGroup = createToggleGroup(item);
                        casementsSection.appendChild(toggleGroup);
                        // Store reference to checkbox for later use
                        casementsToggleCheckbox = document.getElementById(item.id);
                    } else {
                        const sliderGroup = createSliderGroup(item);
                        // Conditionally enable slider based on toggle
                        if (item.enabledBy) {
                            const slider = sliderGroup.querySelector('input[type="range"]');
                            const valueDisplay = sliderGroup.querySelector('.cad-value-display');
                            
                            // Set initial disabled state immediately (assuming toggle is off by default)
                            if (slider && valueDisplay) {
                                slider.disabled = true;
                                sliderGroup.style.opacity = '0.4';
                                sliderGroup.style.pointerEvents = 'none';
                                valueDisplay.style.cursor = 'not-allowed';
                            }
                            
                            const updateSliderState = () => {
                                const enablerCheckbox = casementsToggleCheckbox || document.getElementById(item.enabledBy);
                                if (slider && valueDisplay) {
                                    if (enablerCheckbox && enablerCheckbox.checked) {
                                        slider.disabled = false;
                                        sliderGroup.style.opacity = '1';
                                        sliderGroup.style.pointerEvents = 'auto';
                                        valueDisplay.style.cursor = 'pointer';
                                    } else {
                                        slider.disabled = true;
                                        sliderGroup.style.opacity = '0.4';
                                        sliderGroup.style.pointerEvents = 'none';
                                        valueDisplay.style.cursor = 'not-allowed';
                                    }
                                }
                            };
                            
                            // Update initial state after DOM is ready (in case toggle default is true)
                            requestAnimationFrame(() => {
                                updateSliderState();
                            });
                            
                            // Update when toggle changes
                            if (casementsToggleCheckbox) {
                                casementsToggleCheckbox.addEventListener('change', updateSliderState);
                            } else {
                                // Fallback: try to find checkbox after DOM is ready
                                setTimeout(() => {
                                    const checkbox = document.getElementById(item.enabledBy);
                                    if (checkbox) {
                                        checkbox.addEventListener('change', updateSliderState);
                                        updateSliderState();
                                    }
                                }, 0);
                            }
                        }
                        casementsSection.appendChild(sliderGroup);
                    }
                }
                container.appendChild(casementsSection);
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create slider input group
        // ------------------------------------------------------------
        function createSliderGroup(def) {
            const group = document.createElement('div');
            group.className = 'cad-input-group';
            group.style.minWidth = '100px';

            // Label
            const label = document.createElement('label');
            label.htmlFor = def.id;
            label.textContent = def.label;
            label.style.fontSize = '0.75rem';
            label.style.fontWeight = '700';
            label.style.color = '#666';
            label.style.textTransform = 'uppercase';
            label.style.letterSpacing = '0.5px';
            label.style.marginBottom = '5px';
            group.appendChild(label);

            // Slider container
            const sliderContainer = document.createElement('div');
            sliderContainer.className = 'cad-slider-container';

            const sliderRow = document.createElement('div');
            sliderRow.className = 'cad-slider-row';
            sliderRow.style.display = 'flex';
            sliderRow.style.alignItems = 'center';
            sliderRow.style.gap = '8px';

            // Slider
            const slider = document.createElement('input');
            slider.type = 'range';
            slider.id = def.id;
            slider.min = def.min;
            slider.max = def.max;
            slider.step = def.step;
            slider.value = def.default;
            slider.style.flex = '1';

            // Value display
            const valueDisplay = document.createElement('div');
            valueDisplay.className = 'cad-value-display';
            valueDisplay.innerHTML = `${def.default}<span class="cad-unit">${def.unit}</span>`;
            valueDisplay.style.minWidth = '50px';
            valueDisplay.style.padding = '4px 6px';
            valueDisplay.style.background = '#f5f5f5';
            valueDisplay.style.border = '1px solid #ddd';
            valueDisplay.style.borderRadius = '4px';
            valueDisplay.style.fontSize = '0.8rem';
            valueDisplay.style.fontWeight = '600';
            valueDisplay.style.textAlign = 'center';

            // Events (only fires when slider is enabled)
            slider.addEventListener('input', () => {
                if (slider.disabled) return; // Safety check
                valueDisplay.innerHTML = `${slider.value}<span class="cad-unit">${def.unit}</span>`;
                initMullionOpeningWidths();
                renderPipeline({ preserveCamera: true });
            });

            // Double-click to edit (only if slider is enabled)
            valueDisplay.addEventListener('dblclick', () => {
                if (slider.disabled) return; // Don't allow editing when disabled
                const newVal = prompt(`Enter ${def.label} (${def.min}-${def.max}):`, slider.value);
                if (newVal !== null && !isNaN(newVal)) {
                    slider.value = Math.max(def.min, Math.min(def.max, parseInt(newVal)));
                    valueDisplay.innerHTML = `${slider.value}<span class="cad-unit">${def.unit}</span>`;
                    initMullionOpeningWidths();
                    renderPipeline({ preserveCamera: true });
                }
            });
            valueDisplay.style.cursor = 'pointer';

            sliderRow.appendChild(slider);
            sliderRow.appendChild(valueDisplay);
            sliderContainer.appendChild(sliderRow);
            group.appendChild(sliderContainer);

            return group;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create toggle group
        // ------------------------------------------------------------
        function createToggleGroup(def) {
            const group = document.createElement('div');
            group.className = 'toggle-group';

            const toggleSwitch = document.createElement('label');
            toggleSwitch.className = 'toggle-switch';

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = def.id;
            checkbox.checked = def.default;

            const slider = document.createElement('span');
            slider.className = 'toggle-slider';

            toggleSwitch.appendChild(checkbox);
            toggleSwitch.appendChild(slider);

            const label = document.createElement('span');
            label.className = 'toggle-label';
            label.textContent = def.label;

            checkbox.addEventListener('change', () => {
                renderPipeline({ preserveCamera: true });
            });

            group.appendChild(toggleSwitch);
            group.appendChild(label);

            return group;
        }
        // ---------------------------------------------------------------
        // endregion ===================================================================

        // =============================================================================
        // REGION | Event Handling, Observers, Callbacks
        // =============================================================================
        // UI event handlers, drag handlers, camera change handlers
        // =============================================================================

        // -----------------------------------------------------------------------------
        // UI Event Handlers
        // -----------------------------------------------------------------------------
        const UI_HANDLERS = {
            // Real-time update on any slider change (preserves camera)
            onParamChange: (paramId, value) => {
                renderPipeline({ preserveCamera: true });
            },
            
            // Mullion count changed - reset to even widths
            onMullionChange: (paramId, value) => {
                initMullionOpeningWidths();
                renderPipeline({ preserveCamera: true });
            },
            
            // Full reset with view reset and even opening widths
            onReset: () => {
                initMullionOpeningWidths();
                // Reset camera to origin at 1:1 scale
                const Viewport = window.CadGenerator.Viewport;
                Viewport.setState({ x: 0, y: 0, scale: 1 });
                renderPipeline({ preserveCamera: true });  // Preserve camera (now at origin)
            },
            
            // DXF export
            onDownloadDXF: () => downloadDXF()
        };
        // ---------------------------------------------------------------

        // -----------------------------------------------------------------------------
        // Interactive Drag Handles
        // -----------------------------------------------------------------------------

        // FUNCTION | Setup drag handles on mullions
        // ------------------------------------------------------------
        function setupDragHandles() {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;
            const svg      = document.getElementById('cad-viewport-svg');
            const flipGroup = document.getElementById('flip-group');
            
            if (!svg || !flipGroup) return;

            const numMullions  = parseInt(UI.getValue('mullions'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            const frameThick   = getFrameThickness();
            const innerHeight  = windowHeight - (frameThick * 2);
            const mullionW     = getMullionWidth();
            const handlePadding = getHandlePadding();
            
            // Remove existing handles
            const existingHandles = svg.querySelectorAll('.mullion-handle');
            existingHandles.forEach(h => h.remove());

            // Create invisible drag handles over each mullion
            let xOffset = frameThick;
            for (let i = 0; i < numMullions; i++) {
                xOffset += frameworkOpeningWidths__BetweenMullions[i];
                
                const handleX = xOffset - (handlePadding / 2);
                const handleY = frameThick;
                const handleW = mullionW + handlePadding;
                const handleH = innerHeight;

                const handle = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                handle.setAttribute('class', 'mullion-handle');
                handle.setAttribute('x', handleX);
                handle.setAttribute('y', handleY);
                handle.setAttribute('width', handleW);
                handle.setAttribute('height', handleH);
                handle.setAttribute('fill', '#007bff');
                handle.setAttribute('data-mullion-index', i);
                handle.addEventListener('mousedown', onMullionDragStart);
                
                flipGroup.appendChild(handle);
                xOffset += mullionW;
            }

            // Setup document-level mouse events
            if (mullionDragListeners.move) {
                document.removeEventListener('mousemove', mullionDragListeners.move);
            }
            if (mullionDragListeners.up) {
                document.removeEventListener('mouseup', mullionDragListeners.up);
            }

            mullionDragListeners.move = onMullionDragMove;
            mullionDragListeners.up   = onMullionDragEnd;
            document.addEventListener('mousemove', mullionDragListeners.move);
            document.addEventListener('mouseup', mullionDragListeners.up);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag start
        // ------------------------------------------------------------
        function onMullionDragStart(e) {
            e.preventDefault();
            e.stopPropagation();

            const mullionIndex = parseInt(e.target.dataset.mullionIndex);
            
            dragState = {
                active:       true,
                mullionIndex: mullionIndex,
                startX:       e.clientX,
                startWidths:  [...frameworkOpeningWidths__BetweenMullions]
            };

            e.target.classList.add('dragging');
            document.body.style.cursor = 'ew-resize';
            const canvasWrapper = document.getElementById('canvas-wrapper');
            if (canvasWrapper) canvasWrapper.style.cursor = 'ew-resize';

            // Show feedback tooltip
            const feedback = document.getElementById('drag-feedback');
            feedback.style.display = 'block';
            updateDragFeedback(e.clientX, e.clientY);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag move (FIXED - simplified)
        // ------------------------------------------------------------
        function onMullionDragMove(e) {
            if (!dragState.active) return;

            const Viewport = window.CadGenerator.Viewport;
            const camState = Viewport.getState();
            
            // Calculate delta in screen space, then convert to model space
            const deltaScreen = e.clientX - dragState.startX;
            const deltaModel = deltaScreen / camState.scale;  // <-- Simple scale conversion

            // Get adjacent opening indices
            const leftIdx  = dragState.mullionIndex;
            const rightIdx = dragState.mullionIndex + 1;

            // Calculate new widths
            let newLeftWidth  = dragState.startWidths[leftIdx] + deltaModel;
            let newRightWidth = dragState.startWidths[rightIdx] - deltaModel;

            // Enforce minimum widths
            if (newLeftWidth < MIN_OPENING_WIDTH) {
                newLeftWidth = MIN_OPENING_WIDTH;
                newRightWidth = dragState.startWidths[leftIdx] + dragState.startWidths[rightIdx] - MIN_OPENING_WIDTH;
            }
            if (newRightWidth < MIN_OPENING_WIDTH) {
                newRightWidth = MIN_OPENING_WIDTH;
                newLeftWidth = dragState.startWidths[leftIdx] + dragState.startWidths[rightIdx] - MIN_OPENING_WIDTH;
            }

            // Update widths
            frameworkOpeningWidths__BetweenMullions[leftIdx]  = newLeftWidth;
            frameworkOpeningWidths__BetweenMullions[rightIdx] = newRightWidth;

            // Update feedback
            updateDragFeedback(e.clientX, e.clientY);

            // Regenerate with preserved camera
            renderPipeline({ preserveCamera: true });
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag end
        // ------------------------------------------------------------
        function onMullionDragEnd(e) {
            if (!dragState.active) return;

            dragState.active = false;
            document.body.style.cursor = '';
            const canvasWrapper = document.getElementById('canvas-wrapper');
            if (canvasWrapper) canvasWrapper.style.cursor = 'grab';

            // Hide feedback
            const feedback = document.getElementById('drag-feedback');
            feedback.style.display = 'none';

            // Remove dragging class from handles
            const handles = document.querySelectorAll('.mullion-handle.dragging');
            handles.forEach(h => h.classList.remove('dragging'));

            // Final regenerate
            renderPipeline({ preserveCamera: true });
        }
        // ---------------------------------------------------------------

        // FUNCTION | Update drag feedback tooltip
        // ------------------------------------------------------------
        function updateDragFeedback(mouseX, mouseY) {
            const feedback = document.getElementById('drag-feedback');
            const leftIdx  = dragState.mullionIndex;
            const rightIdx = dragState.mullionIndex + 1;
            
            const leftWidth  = Math.round(frameworkOpeningWidths__BetweenMullions[leftIdx]);
            const rightWidth = Math.round(frameworkOpeningWidths__BetweenMullions[rightIdx]);

            feedback.textContent = `${leftWidth}mm | ${rightWidth}mm`;
            feedback.style.left = (mouseX + 15) + 'px';
            feedback.style.top  = (mouseY - 30) + 'px';
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------


        // ---------------------------------------------------------------------
        // REGION | Verification Helpers
        // ---------------------------------------------------------------------

        // FUNCTION | Verify camera-group membership for interactive elements
        // ------------------------------------------------------------
        function verifyCameraGroupMembership() {
            const cameraGroup = document.getElementById('camera-group');
            if (!cameraGroup) {
                console.warn('[Verify] camera-group not found');
                return;
            }

            const dimensions = document.querySelectorAll('.dim-caption');
            const handles = document.querySelectorAll('.mullion-handle');
            
            let allInGroup = true;
            
            dimensions.forEach(dim => {
                if (!cameraGroup.contains(dim)) {
                    console.error('[Verify] Dimension not in camera-group:', dim);
                    allInGroup = false;
                }
            });
            
            handles.forEach(handle => {
                if (!cameraGroup.contains(handle)) {
                    console.error('[Verify] Handle not in camera-group:', handle);
                    allInGroup = false;
                }
            });
            
            if (allInGroup && (dimensions.length > 0 || handles.length > 0)) {
                console.log(`[Verify] ✓ All elements in camera-group (${dimensions.length} dimensions, ${handles.length} handles)`);
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Verify scale correctness for dimensions and handles
        // ------------------------------------------------------------
        function verifyScale() {
            const Viewport = window.CadGenerator.Viewport;
            const camState = Viewport.getState();
            const UI       = window.CadGenerator.DynamicUI;
            
            if (!currentModel) {
                console.warn('[ScaleCheck] No model loaded');
                return false;
            }

            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));

            console.log(`[ScaleCheck] Camera: scale=${camState.scale.toFixed(4)}, pos=(${camState.x.toFixed(2)}, ${camState.y.toFixed(2)})`);
            console.log(`[ScaleCheck] Window: ${windowWidth}mm × ${windowHeight}mm`);

            // Verify dimension text positions (model coordinates)
            const dimensions = document.querySelectorAll('.dim-caption');
            console.log(`[ScaleCheck] Dimensions: ${dimensions.length} found`);
            dimensions.forEach((dim, idx) => {
                const x = parseFloat(dim.getAttribute('x'));
                const y = parseFloat(dim.getAttribute('y'));
                const fontSize = parseFloat(dim.getAttribute('font-size'));
                console.log(`  [${idx}] "${dim.textContent}" at model (${x.toFixed(0)}, ${y.toFixed(0)}), font-size=${fontSize.toFixed(2)}`);
            });

            // Verify drag handles (model coordinates)
            const handles = document.querySelectorAll('.mullion-handle');
            const numMullions = parseInt(UI.getValue('mullions'));
            const expectedHandles = numMullions;
            console.log(`[ScaleCheck] Handles: ${handles.length} found (expected ${expectedHandles})`);
            
            handles.forEach((handle, idx) => {
                const x = parseFloat(handle.getAttribute('x'));
                const y = parseFloat(handle.getAttribute('y'));
                const w = parseFloat(handle.getAttribute('width'));
                const h = parseFloat(handle.getAttribute('height'));
                console.log(`  [${idx}] pos=(${x.toFixed(0)}, ${y.toFixed(0)}), size=(${w.toFixed(0)} × ${h.toFixed(0)})`);
            });

            // Verify camera transform
            const cameraGroup = document.getElementById('camera-group');
            if (cameraGroup) {
                const transform = cameraGroup.getAttribute('transform');
                console.log(`[ScaleCheck] Camera transform: ${transform}`);
            }

            console.log(`[ScaleCheck] ✓ Verification complete`);
            return true;
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------


        // ---------------------------------------------------------------------
        // REGION | Camera Change Handler
        // ---------------------------------------------------------------------
        // Debounce timer for camera changes (prevents excessive re-renders during drag)
        let _cameraChangeDebounce = null;

        // FUNCTION | Handle camera change events (zoom/pan)
        // ------------------------------------------------------------
        // Called by Viewport when camera transform changes
        // Re-renders dimension captions with counter-scaled font size
        // Uses debouncing to prevent excessive updates during drag
        // ------------------------------------------------------------
        function onCameraChangeHandler(camState) {
            // Clear any pending debounce
            if (_cameraChangeDebounce) {
                cancelAnimationFrame(_cameraChangeDebounce);
            }

            // Debounce using requestAnimationFrame for smooth updates
            _cameraChangeDebounce = requestAnimationFrame(() => {
                // Re-render dimension captions with counter-scaled font size
                renderDimensionCaptions();
                
                // Drag handles are in flip-group (model space) so they
                // auto-scale with camera transform - no action needed
            });
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // =============================================================================
        // REGION | Render Pipeline (Combined)
        // =============================================================================
        // Unified rendering pipeline consolidating all rendering steps
        // =============================================================================

        // FUNCTION | Setup drag handles on mullions
        // ------------------------------------------------------------
        function setupDragHandles() {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;
            const svg      = document.getElementById('cad-viewport-svg');
            const flipGroup = document.getElementById('flip-group');
            
            if (!svg || !flipGroup) return;

            const numMullions  = parseInt(UI.getValue('mullions'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            const frameThick   = getFrameThickness();
            const innerHeight  = windowHeight - (frameThick * 2);
            const mullionW     = getMullionWidth();
            const handlePadding = getHandlePadding();
            
            // Remove existing handles
            const existingHandles = svg.querySelectorAll('.mullion-handle');
            existingHandles.forEach(h => h.remove());

            // Create invisible drag handles over each mullion
            let xOffset = frameThick;
            for (let i = 0; i < numMullions; i++) {
                xOffset += frameworkOpeningWidths__BetweenMullions[i];
                
                const handleX = xOffset - (handlePadding / 2);
                const handleY = frameThick;
                const handleW = mullionW + handlePadding;
                const handleH = innerHeight;

                const handle = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                handle.setAttribute('class', 'mullion-handle');
                handle.setAttribute('x', handleX);
                handle.setAttribute('y', handleY);
                handle.setAttribute('width', handleW);
                handle.setAttribute('height', handleH);
                handle.setAttribute('fill', '#007bff');
                handle.setAttribute('data-mullion-index', i);
                handle.addEventListener('mousedown', onMullionDragStart);
                
                flipGroup.appendChild(handle);
                xOffset += mullionW;
            }

            // Setup document-level mouse events
            if (mullionDragListeners.move) {
                document.removeEventListener('mousemove', mullionDragListeners.move);
            }
            if (mullionDragListeners.up) {
                document.removeEventListener('mouseup', mullionDragListeners.up);
            }

            mullionDragListeners.move = onMullionDragMove;
            mullionDragListeners.up   = onMullionDragEnd;
            document.addEventListener('mousemove', mullionDragListeners.move);
            document.addEventListener('mouseup', mullionDragListeners.up);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Unified render pipeline
        // ------------------------------------------------------------
        // Single entry point for all rendering operations
        // Consolidates: model generation, viewport rendering, layer styling, 
        // dimension captions, drag handles, and status updates
        // ------------------------------------------------------------
        function renderPipeline(options = {}) {
            const {
                preserveCamera = false,
                skipDimensions = false,
                skipHandles = false
            } = options;

            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;
            const M        = Viewport.getMakerJS();

            if (!M) {
                UI.setStatus('Error: Maker.js library not loaded.');
                return false;
            }

            try {
                // Step 1: Normalize data
                normalizeMullionOpeningWidths();
                
                // Step 2: Generate CAD model
                currentModel = generateWindow(M);
                
                // Step 3: Render geometry (Viewport)
                Viewport.render(currentModel, guidesConfig, { 
                    preserveCamera: preserveCamera 
                });
                
                // Step 4: Apply layer styles (dimension colors, casement strokes)
                applyLayerStyles();
                
                // Step 5: Render dimension captions
                if (!skipDimensions) {
                    renderDimensionCaptions();
                }
                
                // Step 6: Setup interactive handles
                if (!skipHandles) {
                    setupDragHandles();
                }
                
                // Step 7: Update status bar
                const numMullions  = parseInt(UI.getValue('mullions'));
                const numOpenings  = numMullions + 1;
                const hBars        = parseInt(UI.getValue('hGlazeBars'));
                const vBars        = parseInt(UI.getValue('vGlazeBars'));
                const cillText     = getShowCill() ? ' + Cill' : '';
                const dimText      = getShowDimensions() ? ' + Dims' : '';
                
                let statusText = '';
                if (numMullions === 0) {
                    statusText = `Single opening (no mullions), ${hBars}×${vBars} glaze bars${cillText}${dimText}.`;
                } else {
                    statusText = `${numMullions} mullion${numMullions !== 1 ? 's' : ''} (${numOpenings} opening${numOpenings !== 1 ? 's' : ''}), ${hBars}×${vBars} glaze bars${cillText}${dimText}. Drag mullions to resize.`;
                }
                UI.setStatus(statusText);

                return true;
            } catch (e) {
                console.error(e);
                UI.setStatus('Error: ' + e.message);
                return false;
            }
        }
        // ---------------------------------------------------------------
        // endregion ===================================================================

        // ---------------------------------------------------------------------
        // REGION | Initialization
        // ---------------------------------------------------------------------
        window.onload = function() {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;

            // Build primary UI from config
            UI.build(UI_CONFIG, UI_HANDLERS);

            // Build secondary controls
            buildSecondaryControls();

            // Initialize viewport (no guides for window configurator)
            Viewport.init('canvas-wrapper', {
                strokeColor:    COLOR_STROKE,
                strokeWidth:    STROKE_WIDTH,
                fillColor:      COLOR_FILL,
                showGroundLine: false,
                showAxisLine:   false,
                fitPadding:     VIEWPORT_FIT_PADDING
            });

            // Register camera change callback for dimension re-rendering on zoom/pan
            Viewport.onCameraChange(onCameraChangeHandler);

            // Register render callback for post-render operations
            Viewport.onRender((model, bounds) => {
                console.log('[Viewport] Render complete. Model bounds:', bounds);
            });

            // Initialize opening widths
            initMullionOpeningWidths();

            // Wait for MakerJS to load
            let attempts = 0;
            const checkInt = setInterval(() => {
                const M = Viewport.getMakerJS();
                if (M) {
                    clearInterval(checkInt);
                    UI.showLoading(false);
                    
                    // Initial render at origin (1:1 scale)
                    renderPipeline({ preserveCamera: false });
                    
                    // Log initial scale verification
                    console.log('[Init] Initial render complete. Running scale verification...');
                } else if (attempts > 10) {
                    clearInterval(checkInt);
                    UI.setStatus('Failed to load libraries. Check connection.');
                }
                attempts++;
            }, 200);
        };
        // endregion -----------------------------------------------------------



        // ---------------------------------------------------------------------
        // REGION | Console Test Helpers
        // ---------------------------------------------------------------------
        window.testScaling = function() {
            console.log('===== SCALING VERIFICATION TEST =====');
            verifyCameraGroupMembership();
            verifyScale();
            console.log('===== TEST COMPLETE =====');
        };
        
        window.testDimensions = function() {
            console.log('===== DIMENSION TEXT VERIFICATION =====');
            const dimensions = document.querySelectorAll('.dim-caption');
            const camState = window.CadGenerator.Viewport.getState();
            
            console.log(`Camera scale: ${camState.scale.toFixed(4)}`);
            console.log(`Found ${dimensions.length} dimensions\n`);
            
            dimensions.forEach((dim, idx) => {
                const x = parseFloat(dim.getAttribute('x'));
                const y = parseFloat(dim.getAttribute('y'));
                const fontSize = parseFloat(dim.getAttribute('font-size'));
                const text = dim.textContent;
                
                console.log(`[${idx}] "${text}"`);
                console.log(`  Position: (${x.toFixed(2)}, ${y.toFixed(2)}) [model coords]`);
                console.log(`  Font size: ${fontSize.toFixed(2)} [counter-scaled for readability]`);
            });
            
            console.log('\n===== TEST COMPLETE =====');
        };
        
        console.log('%c[Window Configurator] Test functions available:', 'color: #4CAF50; font-weight: bold');
        console.log('  testScaling() - Verify scaling system');
        console.log('  testDimensions() - Verify dimension text');
        console.log('  verifyScale() - Full verification report');
        console.log('  verifyCameraGroupMembership() - Check element hierarchy');
        // endregion -----------------------------------------------------------
    </script>
</body>
</html>
