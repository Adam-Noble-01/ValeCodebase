## Do / Don't

```js
// CORRECT
async function ValeSpec__ConfigLoader__LoadConfig() { ... }
function ValeSpec__ModeManager__HideAllPanels() { ... }
let ValeSpec__StateManager__State = {};
window.ValeSpec__AppCore__StateManager.ValeSpec__StateManager__SetCurrentMode('AssemblyEditor');

// WRONG — plain camelCase at module scope
async function loadConfig() { ... }

// WRONG — underscore prefix instead of namespace
function _hideAllPanels() { ... }

// WRONG — single underscore separator
function ValeSpec_ModeManager_SwitchToMode() { ... }
```
