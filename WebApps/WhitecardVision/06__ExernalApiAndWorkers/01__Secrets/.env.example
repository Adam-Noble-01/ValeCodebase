# =============================================================================
# WHITECARDVISION - ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================================
# Copy this file to .env in the same folder and populate GEMINI_API_KEY.
# The .env file is gitignored and must NEVER be committed.
# =============================================================================

# Google Gemini API key - obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY={YOUR_GEMINI_API_KEY}

# Model identifier (locked to the Pro image model - Nano Banana Pro).
# DO NOT change this to a flash-image model - outputs will be rejected by the
# server proxy per the WhitecardVision spec (professional-grade only).
GEMINI_MODEL_ID=gemini-3-pro-image-preview

# Base URL for the Gemini REST API. Matches the official docs.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Default image size passed to the Gemini imageConfig (string; uppercase K).
# Valid values: "512" | "1K" | "2K" | "4K". Aspect ratio is derived from the
# uploaded Whitecard image at runtime and is NEVER read from .env.
GEMINI_DEFAULT_IMAGE_SIZE=2K

# Outbound request timeout in seconds for the Gemini proxy.
GEMINI_REQUEST_TIMEOUT_SECONDS=180
