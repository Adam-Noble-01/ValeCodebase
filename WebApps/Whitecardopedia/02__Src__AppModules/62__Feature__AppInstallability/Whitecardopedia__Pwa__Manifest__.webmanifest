{
    "id": "../../../",
    "name": "ValeVision 3D",
    "short_name": "ValeVision 3D",
    "description": "ValeVision 3D project viewer and Whitecardopedia review suite for Vale Garden Houses architectural projects.",
    "categories": ["productivity", "business", "utilities"],
    "lang": "en-GB",
    "dir": "ltr",
    "start_url": "../../app.html",
    "scope": "../../../",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "handle_links": "preferred",
    "protocol_handlers": [
        {
            "protocol": "web+valevision",
            "url": "../../ShareLink__OpenInApp__.html?protocol=%s"
        }
    ],
    "orientation": "any",
    "theme_color": "#172b3a",
    "background_color": "#172b3a",
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "./Na__AppInstallability__Icon__192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./Na__AppInstallability__Icon__192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./Na__AppInstallability__Icon__512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./Na__AppInstallability__Icon__512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Whitecardopedia gallery",
            "short_name": "Gallery",
            "description": "Open the project gallery in Whitecardopedia.",
            "url": "../../app.html",
            "icons": [
                {
                    "src": "./Na__AppInstallability__Icon__192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "ValeVision 3D viewer",
            "short_name": "3D viewer",
            "description": "Open the ValeVision 3D model viewer.",
            "url": "../../../ValeVision3D/index.html",
            "icons": [
                {
                    "src": "./Na__AppInstallability__Icon__192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}
