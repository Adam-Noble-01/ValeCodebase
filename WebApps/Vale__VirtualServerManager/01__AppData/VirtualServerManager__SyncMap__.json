{
    "_About": "Sync map for the Vale Virtual Server Manager. Local.MirrorRoot IS Server.Root. Lanes: code (PC->server mirror), content (PC->server, newer wins), userdata (server->PC, newer wins), shared (both ways, newer wins). A mapping's DefaultLane (code or shared) applies to folders not named for a lane. ServerMadeContent: folders (by name) whose content is written on the server, e.g. ValeVision Theia's videos; their server-only and server-newer content is collected by every Collect, and they cannot be pruned. Edit in the app (http://127.0.0.1:8020) or here. Remote paths are relative to Server.Root and can never leave it.",
    "Server": {
        "HostAlias": "valevps",
        "Root": "/srv/vale",
        "SyncArea": "/srv/vale-sync",
        "KeepBackups": 30
    },
    "Local": {
        "MirrorRoot": "D:\\10_CoreLib__ValeCodebase\\WebApps\\Vale__VirtualServer",
        "BackupRoot": "D:\\10_CoreLib__ValeCodebase\\WebApps\\Vale__VirtualServerManager\\90__ServerBackups"
    },
    "NeverSync": [
        ".git/",
        ".gitignore",
        ".gitattributes",
        ".claude/",
        ".vscode/",
        "*.env",
        ".env*",
        ".dev.vars",
        "*.--HIDDEN",
        "*.pem",
        "*.key",
        "id_rsa*",
        "id_ed25519*",
        "id_ecdsa*",
        "Thumbs.db",
        "desktop.ini",
        ".DS_Store",
        "*.tmp",
        "~$*",
        "*.lnk",
        "*.code-workspace",
        "*.lock",
        "ValeApps__DeployStamp__.json"
    ],
    "KindExcludes": {
        "web": [
            "*.md",
            "*.py",
            "*.pyc",
            "__pycache__/",
            "*.bat",
            "*.ps1",
            "*.sh",
            "*.log",
            "node_modules/",
            "package.json",
            "package-lock.json",
            ".npmrc",
            "*.psd",
            "*.psb",
            "*.skp",
            "*.skb",
            "*.zip",
            "*.patch",
            "00__Archive*/",
            "60__Dev__*/",
            "8?__Testing*/",
            "85__EarlyStage*/",
            "9?__Dev__*/"
        ],
        "server": [
            "__pycache__/",
            "*.pyc",
            "*.log",
            "venv/",
            ".venv/",
            "node_modules/"
        ]
    },
    "LanePatterns": {
        "content": [
            "Content__*",
            "*__ProjectContent*",
            "*__HeavyContent*",
            "*__Content",
            "*__Content__*"
        ],
        "userdata": [
            "UserData__*",
            "*__UserData*",
            "*__UserConfig*",
            "*__User*Content*",
            "*__ProjectData*",
            "*__ServerData*",
            "*__Revisions*",
            "*LocalUserData*",
            "*LocalProjectData*"
        ]
    },
    "ServerMadeContent": [
        "ValeVision__TheiaVideo"
    ],
    "Mappings": [
        {
            "Id": "root-files",
            "Name": "Server root files (landing page)",
            "Kind": "web",
            "Local": ".",
            "Remote": ".",
            "FilesOnly": true,
            "Enabled": true,
            "AllowDeletes": false,
            "Exclude": [],
            "Content": [],
            "UserData": [],
            "DefaultLane": "code"
        },
        {
            "Id": "server-api",
            "Name": "Server API (internal app APIs, never web-served)",
            "Kind": "server",
            "Local": "Server__Api",
            "Remote": "Server__Api",
            "Enabled": true,
            "AllowDeletes": true,
            "Exclude": [],
            "Content": [],
            "UserData": [],
            "DefaultLane": "code"
        },
        {
            "Id": "server-devtools",
