; #region  - - - |  Clear Ruby Console  | - -
::;r_Clear::
::;r__Clear::
::;rb_Clear::
::;rb__Clear::
::;r_ClearConsole::
::;r__ClearConsole::
::;rb_ClearConsole::
::;rb__ClearConsole::
{
    SendRaw, def clear_console; puts "\n" * 100; end; clear_console
    Sleep, 50
    Send, {Enter}
    return
}
; #endregion | - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - |

