<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parametric Window Configurator (Maker.js)</title>
    
    <!-- External Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bezier-js@2.1.0/dist/bezier.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/opentype.js@0.7.3/dist/opentype.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/makerjs@0/target/js/browser.maker.js"></script>

    <!-- CAD Generator Modules (shared from PatioGenerator folder) -->
    <script src="../Prototype__PatioGenerator__CadGeneration__MakerJs/CadGenerator__ViewportAndNavigation.js"></script>
    <script src="../Prototype__PatioGenerator__CadGeneration__MakerJs/CadGenerator__DynamicUI.js"></script>
    <script src="../Prototype__PatioGenerator__CadGeneration__MakerJs/CadGenerator__DxfExportFunction.js"></script>

    <style>
        /* ---------------------------------------------------------------------
         * REGION | Page Layout Styles
         * ------------------------------------------------------------------ */
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            padding: 20px; 
            background: #f0f2f5; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            min-height: 100vh;
            margin: 0;
            box-sizing: border-box;
        }

        h1 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.5rem;
        }

        .subtitle {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }
        /* endregion -------------------------------------------------------- */

        /* ---------------------------------------------------------------------
         * REGION | Control Panel Row Styles
         * ------------------------------------------------------------------ */
        .controls-row {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 10px;
        }

        .controls-section {
            background: #f8f9fa;
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        .controls-section-title {
            font-size: 0.7rem;
            font-weight: 700;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        /* endregion -------------------------------------------------------- */

        /* ---------------------------------------------------------------------
         * REGION | Toggle Switch Styles
         * ------------------------------------------------------------------ */
        .toggle-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toggle-switch {
            position: relative;
            width: 44px;
            height: 24px;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.3s;
            border-radius: 24px;
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }

        .toggle-switch input:checked + .toggle-slider {
            background-color: #007bff;
        }

        .toggle-switch input:checked + .toggle-slider:before {
            transform: translateX(20px);
        }

        .toggle-label {
            font-size: 0.8rem;
            color: #555;
            font-weight: 500;
        }
        /* endregion -------------------------------------------------------- */

        /* ---------------------------------------------------------------------
         * REGION | Drag Handle Styles
         * ------------------------------------------------------------------ */
        .mullion-handle {
            cursor: ew-resize;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .mullion-handle:hover {
            opacity: 0.3;
        }

        .mullion-handle.dragging {
            opacity: 0.5;
        }

        .drag-feedback {
            position: fixed;
            background: rgba(0, 123, 255, 0.9);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            pointer-events: none;
            z-index: 1000;
            display: none;
        }
        /* endregion -------------------------------------------------------- */
    </style>
</head>
<body>

    <h1>Window Configurator</h1>
    <p class="subtitle">Drag sliders for real-time preview. Double-click values for precise input. Drag mullions to resize casements.</p>

    <!-- Control Panel (Built by DynamicUI) -->
    <div id="controls"></div>

    <!-- Secondary Controls Row -->
    <div id="controls-secondary" class="controls-row"></div>

    <!-- Canvas Wrapper (Managed by Viewport) -->
    <div id="canvas-wrapper"></div>
    
    <!-- Status Bar -->
    <div id="status-bar">Initializing...</div>

    <!-- Drag Feedback Tooltip -->
    <div id="drag-feedback" class="drag-feedback"></div>

    <script>
        // ---------------------------------------------------------------------
        // REGION | UI Configuration (JSON Config Header)
        // ---------------------------------------------------------------------
        // INDEX: This config defines which UI elements are built
        // ┌────────────────────────────────────────────────────────────────────┐
        // │ INPUTS - Primary Row:                                              │
        // │   - windowWidth   : Window width in mm (600-4000)                  │
        // │   - windowHeight  : Window height in mm (400-3000)                 │
        // │   - casements     : Number of casement divisions (1-6)             │
        // │   - hGlazeBars    : Horizontal glaze bars per casement (0-5)       │
        // │   - vGlazeBars    : Vertical glaze bars per casement (0-5)         │
        // │                                                                    │
        // │ INPUTS - Secondary Row:                                            │
        // │   - frameThickness : Main frame thickness (0-100mm)                │
        // │   - casementWidth  : Casement frame width (20-175mm)               │
        // │   - glazeBarWidth  : Glaze bar width (10-50mm)                     │
        // │   - showCill       : Toggle for window cill                        │
        // │                                                                    │
        // │ BUTTONS:                                                           │
        // │   - reset-btn     : Resets view and casement widths to even        │
        // │   - dxf-btn       : Downloads DXF file                             │
        // └────────────────────────────────────────────────────────────────────┘
        const UI_CONFIG = {
            containerId:      'controls',
            statusBarId:      'status-bar',
            canvasWrapperId:  'canvas-wrapper',
            loadingText:      'Loading CAD Libraries...',
            
            inputs: [
                { id: 'windowWidth',  label: 'Width',     default: 1800, min: 600,  max: 4000, step: 50, unit: 'mm', onChange: 'onParamChange', width: '140px' },
                { id: 'windowHeight', label: 'Height',    default: 1200, min: 400,  max: 3000, step: 50, unit: 'mm', onChange: 'onParamChange', width: '140px' },
                { id: 'casements',    label: 'Casements', default: 2,    min: 1,    max: 6,    step: 1,  unit: '',   onChange: 'onCasementChange', width: '100px' },
                { id: 'hGlazeBars',   label: 'H Bars',    default: 0,    min: 0,    max: 5,    step: 1,  unit: '',   onChange: 'onParamChange', width: '90px' },
                { id: 'vGlazeBars',   label: 'V Bars',    default: 0,    min: 0,    max: 5,    step: 1,  unit: '',   onChange: 'onParamChange', width: '90px' }
            ],
            
            buttons: [
                { id: 'reset-btn', label: 'Reset View',    action: 'onReset',       style: 'primary' },
                { id: 'dxf-btn',   label: 'Download DXF',  action: 'onDownloadDXF', style: 'success' }
            ]
        };

        // Secondary controls config (built manually for toggle support)
        const SECONDARY_CONFIG = {
            containerId: 'controls-secondary',
            inputs: [
                { id: 'frameThickness', label: 'Frame',      default: 50,  min: 0,   max: 100, step: 5,  unit: 'mm' },
                { id: 'casementWidth',  label: 'Casement',   default: 65,  min: 20,  max: 175, step: 5,  unit: 'mm' },
                { id: 'glazeBarWidth',  label: 'Glaze Bar',  default: 25,  min: 10,  max: 50,  step: 1,  unit: 'mm' }
            ],
            toggles: [
                { id: 'showCill', label: 'Window Cill', default: true },
                { id: 'showDimensions', label: 'Dimensions', default: true }
            ]
        };
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Window Configuration Defaults
        // ---------------------------------------------------------------------
        const CILL_HEIGHT        = 50;                                           // <-- Cill height (mm)
        const CILL_HORN_OVERHANG = 50;                                           // <-- Cill horn overhang each side (mm)
        const DIM_OFFSET         = 100;                                          // <-- Dimension line offset (mm)
        const DIM_ARROW_SIZE     = 12;                                           // <-- Dimension arrow size (mm)
        const DIM_TEXT_SIZE      = 30;                                           // <-- Dimension text size in mm (CAD units)
        const MIN_CASEMENT_WIDTH = 150;                                          // <-- Minimum casement width (mm)
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Global State
        // ---------------------------------------------------------------------
        let currentModel     = null;                                             // <-- Current Maker.js model
        let casementWidths   = [];                                               // <-- Individual casement widths
        let dragState        = {                                                 // <-- Drag interaction state
            active:       false,
            mullionIndex: -1,
            startX:       0,
            startWidths:  []
        };

        const guidesConfig = {                                                   // <-- Viewport guides config
            showGround:  false,
            showAxis:    false,
            strokeColor: '#2c3e50',
            strokeWidth: 2,
            fillColor:   'none',
            layerOptions: {                                                      // <-- Layer-specific styling
                '00__Dimensions': { 
                    stroke: '#e74c3c',                                           // <-- Red dimension lines
                    fill: '#e74c3c'                                              // <-- Red dimension text
                }
            }
        };
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Parameter Getters
        // ---------------------------------------------------------------------

        // FUNCTION | Get current frame thickness from slider
        // ------------------------------------------------------------
        function getFrameThickness() {
            const el = document.getElementById('frameThickness');
            return el ? parseInt(el.value) : 50;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get current casement width from slider
        // ------------------------------------------------------------
        function getCasementFrameWidth() {
            const el = document.getElementById('casementWidth');
            return el ? parseInt(el.value) : 65;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get current glaze bar width from slider
        // ------------------------------------------------------------
        function getGlazeBarWidth() {
            const el = document.getElementById('glazeBarWidth');
            return el ? parseInt(el.value) : 25;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get cill toggle state
        // ------------------------------------------------------------
        function getShowCill() {
            const el = document.getElementById('showCill');
            return el ? el.checked : true;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get dimensions toggle state
        // ------------------------------------------------------------
        function getShowDimensions() {
            const el = document.getElementById('showDimensions');
            return el ? el.checked : true;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Get mullion width (same as casement frame width)
        // ------------------------------------------------------------
        function getMullionWidth() {
            return getCasementFrameWidth();
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Master Coordinate Transformation System
        // ---------------------------------------------------------------------
        // All coordinate conversions use these helpers for consistency
        // CAD coordinates: Cartesian system with Y+ pointing upward
        // Screen coordinates: SVG system with Y+ pointing downward, includes pan/zoom
        // ---------------------------------------------------------------------

        // FUNCTION | Convert CAD (Cartesian Y+ up) to Screen coordinates
        // ------------------------------------------------------------
        function cadToScreen(cadX, cadY, camState) {
            const worldY = -cadY;                                                // <-- Flip Y-axis (CAD to World)
            const screenX = cadX * camState.scale + camState.x;                  // <-- Apply scale and pan X
            const screenY = worldY * camState.scale + camState.y;                // <-- Apply scale and pan Y
            return { x: screenX, y: screenY };
        }
        // ---------------------------------------------------------------

        // FUNCTION | Convert screen coordinates back to CAD coordinates
        // ------------------------------------------------------------
        function screenToCad(screenX, screenY, camState) {
            const cadX = (screenX - camState.x) / camState.scale;                // <-- Remove pan and scale X
            const worldY = (screenY - camState.y) / camState.scale;              // <-- Remove pan and scale Y
            const cadY = -worldY;                                                // <-- Flip Y-axis back (World to CAD)
            return { x: cadX, y: cadY };
        }
        // ---------------------------------------------------------------

        // FUNCTION | Calculate rotation angle for text in screen space
        // ------------------------------------------------------------
        function getTextRotation(cadDx, cadDy) {
            // Text rotation is based on CAD vector direction
            // When converted to screen, Y is flipped, so angle calculation accounts for this
            const angle = Math.atan2(-cadDy, cadDx) * (180 / Math.PI);          // <-- Negate dy for Y-flip
            return angle;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Debug coordinate transformation (optional)
        // ------------------------------------------------------------
        function debugCoordinates(cadX, cadY, label) {
            const camState = window.CadGenerator.Viewport.getState();
            const screen = cadToScreen(cadX, cadY, camState);
            console.log(`${label}: CAD(${cadX}, ${cadY}) -> Screen(${screen.x.toFixed(2)}, ${screen.y.toFixed(2)})`);
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | UI Event Handlers
        // ---------------------------------------------------------------------
        const UI_HANDLERS = {
            // Real-time update on any slider change (preserves camera)
            onParamChange: (paramId, value) => {
                regenerateModel(true);
            },
            
            // Casement count changed - reset to even widths
            onCasementChange: (paramId, value) => {
                initCasementWidths();
                regenerateModel(true);
            },
            
            // Full reset with view reset and even casement widths
            onReset: () => {
                initCasementWidths();
                regenerateModel(false);
            },
            
            // DXF export
            onDownloadDXF: () => downloadDXF()
        };
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Secondary UI Builder
        // ---------------------------------------------------------------------

        // FUNCTION | Build secondary controls with toggles
        // ------------------------------------------------------------
        function buildSecondaryControls() {
            const container = document.getElementById(SECONDARY_CONFIG.containerId);
            if (!container) return;

            container.innerHTML = '';

            // Build slider inputs section
            const slidersSection = document.createElement('div');
            slidersSection.className = 'controls-section';
            
            const slidersTitle = document.createElement('div');
            slidersTitle.className = 'controls-section-title';
            slidersTitle.textContent = 'Frame Dimensions';
            slidersSection.appendChild(slidersTitle);

            const slidersRow = document.createElement('div');
            slidersRow.style.display = 'flex';
            slidersRow.style.gap = '15px';

            for (const input of SECONDARY_CONFIG.inputs) {
                const group = createSliderGroup(input);
                slidersRow.appendChild(group);
            }
            slidersSection.appendChild(slidersRow);
            container.appendChild(slidersSection);

            // Build toggles section
            const togglesSection = document.createElement('div');
            togglesSection.className = 'controls-section';
            
            const togglesTitle = document.createElement('div');
            togglesTitle.className = 'controls-section-title';
            togglesTitle.textContent = 'Options';
            togglesSection.appendChild(togglesTitle);

            for (const toggle of SECONDARY_CONFIG.toggles) {
                const toggleGroup = createToggleGroup(toggle);
                togglesSection.appendChild(toggleGroup);
            }
            container.appendChild(togglesSection);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create slider input group
        // ------------------------------------------------------------
        function createSliderGroup(def) {
            const group = document.createElement('div');
            group.className = 'cad-input-group';
            group.style.minWidth = '100px';

            // Label
            const label = document.createElement('label');
            label.htmlFor = def.id;
            label.textContent = def.label;
            label.style.fontSize = '0.75rem';
            label.style.fontWeight = '700';
            label.style.color = '#666';
            label.style.textTransform = 'uppercase';
            label.style.letterSpacing = '0.5px';
            label.style.marginBottom = '5px';
            group.appendChild(label);

            // Slider container
            const sliderContainer = document.createElement('div');
            sliderContainer.className = 'cad-slider-container';

            const sliderRow = document.createElement('div');
            sliderRow.className = 'cad-slider-row';
            sliderRow.style.display = 'flex';
            sliderRow.style.alignItems = 'center';
            sliderRow.style.gap = '8px';

            // Slider
            const slider = document.createElement('input');
            slider.type = 'range';
            slider.id = def.id;
            slider.min = def.min;
            slider.max = def.max;
            slider.step = def.step;
            slider.value = def.default;
            slider.style.flex = '1';

            // Value display
            const valueDisplay = document.createElement('div');
            valueDisplay.className = 'cad-value-display';
            valueDisplay.innerHTML = `${def.default}<span class="cad-unit">${def.unit}</span>`;
            valueDisplay.style.minWidth = '50px';
            valueDisplay.style.padding = '4px 6px';
            valueDisplay.style.background = '#f5f5f5';
            valueDisplay.style.border = '1px solid #ddd';
            valueDisplay.style.borderRadius = '4px';
            valueDisplay.style.fontSize = '0.8rem';
            valueDisplay.style.fontWeight = '600';
            valueDisplay.style.textAlign = 'center';

            // Events
            slider.addEventListener('input', () => {
                valueDisplay.innerHTML = `${slider.value}<span class="cad-unit">${def.unit}</span>`;
                initCasementWidths();
                regenerateModel(true);
            });

            // Double-click to edit
            valueDisplay.addEventListener('dblclick', () => {
                const newVal = prompt(`Enter ${def.label} (${def.min}-${def.max}):`, slider.value);
                if (newVal !== null && !isNaN(newVal)) {
                    slider.value = Math.max(def.min, Math.min(def.max, parseInt(newVal)));
                    valueDisplay.innerHTML = `${slider.value}<span class="cad-unit">${def.unit}</span>`;
                    initCasementWidths();
                    regenerateModel(true);
                }
            });
            valueDisplay.style.cursor = 'pointer';

            sliderRow.appendChild(slider);
            sliderRow.appendChild(valueDisplay);
            sliderContainer.appendChild(sliderRow);
            group.appendChild(sliderContainer);

            return group;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create toggle group
        // ------------------------------------------------------------
        function createToggleGroup(def) {
            const group = document.createElement('div');
            group.className = 'toggle-group';

            const toggleSwitch = document.createElement('label');
            toggleSwitch.className = 'toggle-switch';

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = def.id;
            checkbox.checked = def.default;

            const slider = document.createElement('span');
            slider.className = 'toggle-slider';

            toggleSwitch.appendChild(checkbox);
            toggleSwitch.appendChild(slider);

            const label = document.createElement('span');
            label.className = 'toggle-label';
            label.textContent = def.label;

            checkbox.addEventListener('change', () => {
                regenerateModel(true);
            });

            group.appendChild(toggleSwitch);
            group.appendChild(label);

            return group;
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Casement Width Management
        // ---------------------------------------------------------------------

        // FUNCTION | Initialize casement widths to even distribution
        // ------------------------------------------------------------
        function initCasementWidths() {
            const UI           = window.CadGenerator.DynamicUI;
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const numCasements = parseInt(UI.getValue('casements'));
            const frameThick   = getFrameThickness();
            const mullionW     = getMullionWidth();
            
            const innerWidth        = windowWidth - (frameThick * 2);
            const totalMullionWidth = (numCasements - 1) * mullionW;
            const availableWidth    = innerWidth - totalMullionWidth;
            const evenWidth         = availableWidth / numCasements;
            
            casementWidths = Array(numCasements).fill(evenWidth);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Validate and normalize casement widths
        // ------------------------------------------------------------
        function normalizeCasementWidths() {
            const UI           = window.CadGenerator.DynamicUI;
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const numCasements = parseInt(UI.getValue('casements'));
            const frameThick   = getFrameThickness();
            const mullionW     = getMullionWidth();
            
            const innerWidth        = windowWidth - (frameThick * 2);
            const totalMullionWidth = (numCasements - 1) * mullionW;
            const availableWidth    = innerWidth - totalMullionWidth;
            
            // Ensure array length matches casement count
            if (casementWidths.length !== numCasements) {
                initCasementWidths();
                return;
            }
            
            // Enforce minimum widths
            for (let i = 0; i < casementWidths.length; i++) {
                if (casementWidths[i] < MIN_CASEMENT_WIDTH) {
                    casementWidths[i] = MIN_CASEMENT_WIDTH;
                }
            }
            
            // Normalize to fit available width
            const currentTotal = casementWidths.reduce((a, b) => a + b, 0);
            if (Math.abs(currentTotal - availableWidth) > 0.1) {
                const scale = availableWidth / currentTotal;
                casementWidths = casementWidths.map(w => w * scale);
            }
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Main Generation Logic
        // ---------------------------------------------------------------------

        // FUNCTION | Regenerate model (optionally preserving camera)
        // ------------------------------------------------------------
        function regenerateModel(preserveCamera = false) {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;
            const M        = Viewport.getMakerJS();

            if (!M) {
                UI.setStatus('Error: Maker.js library not loaded.');
                return;
            }

            try {
                // Normalize casement widths before generation
                normalizeCasementWidths();
                
                // Generate model
                currentModel = generateWindow(M);
                
                // Render with camera preservation option
                Viewport.render(currentModel, guidesConfig, { 
                    preserveCamera: preserveCamera 
                });
                
                // Apply layer-specific styling (dimension lines red)
                applyLayerStyles();
                
                // Only zoom extents if not preserving camera
                if (!preserveCamera) {
                    setTimeout(() => {
                        Viewport.zoomExtents();
                        renderDimensionCaptions();
                    }, 50);
                } else {
                    // Render dimension captions
                    setTimeout(() => renderDimensionCaptions(), 10);
                }

                // Setup drag handles after render
                setupDragHandles();

                // Update status
                const numCasements = parseInt(UI.getValue('casements'));
                const hBars        = parseInt(UI.getValue('hGlazeBars'));
                const vBars        = parseInt(UI.getValue('vGlazeBars'));
                const cillText     = getShowCill() ? ' + Cill' : '';
                const dimText      = getShowDimensions() ? ' + Dims' : '';
                UI.setStatus(`${numCasements} casement${numCasements > 1 ? 's' : ''}, ${hBars}×${vBars} glaze bars${cillText}${dimText}. Drag mullions to resize.`);
            } catch (e) {
                console.error(e);
                UI.setStatus('Error: ' + e.message);
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Generate complete window model
        // ------------------------------------------------------------
        function generateWindow(M) {
            const UI = window.CadGenerator.DynamicUI;

            // Get parameters
            const windowWidth  = parseInt(UI.getValue('windowWidth'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            const numCasements = parseInt(UI.getValue('casements'));
            const hGlazeBars   = parseInt(UI.getValue('hGlazeBars'));
            const vGlazeBars   = parseInt(UI.getValue('vGlazeBars'));
            const frameThick   = getFrameThickness();
            const showCill     = getShowCill();

            // Model container
            const windowModel = { 
                models: {},
                paths: {},
                units: M.unitType.Millimeter 
            };

            // 1. Create outer frame (if thickness > 0)
            if (frameThick > 0) {
                windowModel.models.outerFrame = createOuterFrame(M, windowWidth, windowHeight, frameThick);
            } else {
                // Just outer rectangle when no frame
                windowModel.models.outerRect = {
                    models: { rect: new M.models.Rectangle(windowWidth, windowHeight) }
                };
            }

            // 2. Create casements with mullions
            const casementModels = createCasements(M, windowWidth, windowHeight, numCasements, frameThick);
            Object.assign(windowModel.models, casementModels);

            // 3. Add glaze bars to each casement
            addGlazeBarsToModel(M, windowModel, windowHeight, hGlazeBars, vGlazeBars, frameThick);

            // 4. Add window cill if enabled
            if (showCill) {
                windowModel.models.cill = createWindowCill(M, windowWidth);
            }

            // 5. Create dimension annotations (if enabled)
            if (getShowDimensions()) {
                createDimensions(M, windowModel, windowWidth, windowHeight, numCasements, frameThick, showCill);
            }

            return windowModel;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Download DXF file
        // ------------------------------------------------------------
        function downloadDXF() {
            const DxfExport = window.CadGenerator.DxfExport;
            DxfExport.download(currentModel, 'Window', {
                layerOptions: {
                    '00__Dimensions': { color: 1 }                               // <-- Red (AutoCAD color code 1)
                }
            });
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Frame Generation
        // ---------------------------------------------------------------------

        // FUNCTION | Create outer frame (double rectangle)
        // ------------------------------------------------------------
        function createOuterFrame(M, width, height, frameThick) {
            return {
                models: {
                    outer: new M.models.Rectangle(width, height),
                    inner: {
                        models: {
                            rect: new M.models.Rectangle(
                                width - (frameThick * 2),
                                height - (frameThick * 2)
                            )
                        },
                        origin: [frameThick, frameThick]
                    }
                }
            };
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create window cill
        // ------------------------------------------------------------
        function createWindowCill(M, windowWidth) {
            const cillWidth = windowWidth + (CILL_HORN_OVERHANG * 2);
            const cillX     = -CILL_HORN_OVERHANG;
            const cillY     = -CILL_HEIGHT;

            return {
                models: {
                    rect: new M.models.Rectangle(cillWidth, CILL_HEIGHT)
                },
                origin: [cillX, cillY]
            };
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Casement Generation
        // ---------------------------------------------------------------------

        // FUNCTION | Create casement divisions and mullions
        // ------------------------------------------------------------
        function createCasements(M, width, height, numCasements, frameThick) {
            const casements   = {};
            const innerHeight = height - (frameThick * 2);
            const mullionW    = getMullionWidth();
            
            let xOffset = frameThick;

            for (let i = 0; i < numCasements; i++) {
                const casementWidth = casementWidths[i];
                
                // Create casement frame
                casements[`casement_${i}`] = {
                    models: {
                        frame: new M.models.Rectangle(casementWidth, innerHeight)
                    },
                    origin: [xOffset, frameThick]
                };

                // Store casement data for drag handles
                casements[`casement_${i}`]._data = {
                    index: i,
                    x: xOffset,
                    width: casementWidth
                };

                xOffset += casementWidth;

                // Add mullion (except after last casement)
                if (i < numCasements - 1) {
                    casements[`mullion_${i}`] = {
                        models: {
                            rect: new M.models.Rectangle(mullionW, innerHeight)
                        },
                        origin: [xOffset, frameThick],
                        _data: {
                            index: i,
                            x: xOffset
                        }
                    };
                    xOffset += mullionW;
                }
            }

            return casements;
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Glaze Bar Generation
        // ---------------------------------------------------------------------

        // FUNCTION | Add glaze bars to all casements
        // ------------------------------------------------------------
        function addGlazeBarsToModel(M, windowModel, windowHeight, hBars, vBars, frameThick) {
            const innerHeight   = windowHeight - (frameThick * 2);
            const glazeBarWidth = getGlazeBarWidth();

            for (let i = 0; i < casementWidths.length; i++) {
                const casementKey = `casement_${i}`;
                const casement    = windowModel.models[casementKey];
                
                if (!casement) continue;

                const casementWidth = casementWidths[i];

                // Add horizontal glaze bars
                if (hBars > 0) {
                    const hSpacing = innerHeight / (hBars + 1);
                    for (let h = 0; h < hBars; h++) {
                        const yPos = hSpacing * (h + 1);
                        casement.models[`hBar_${h}`] = {
                            models: {
                                rect: new M.models.Rectangle(casementWidth, glazeBarWidth)
                            },
                            origin: [0, yPos - (glazeBarWidth / 2)]
                        };
                    }
                }

                // Add vertical glaze bars
                if (vBars > 0) {
                    const vSpacing = casementWidth / (vBars + 1);
                    for (let v = 0; v < vBars; v++) {
                        const xPos = vSpacing * (v + 1);
                        casement.models[`vBar_${v}`] = {
                            models: {
                                rect: new M.models.Rectangle(glazeBarWidth, innerHeight)
                            },
                            origin: [xPos - (glazeBarWidth / 2), 0]
                        };
                    }
                }
            }
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Dimension Annotations (Layer: 00__Dimensions)
        // ---------------------------------------------------------------------
        const DIM_LAYER = '00__Dimensions';                                      // <-- Dimension layer name

        // FUNCTION | Create all dimension annotations
        // ------------------------------------------------------------
        function createDimensions(M, windowModel, width, height, numCasements, frameThick, showCill) {
            const cillOffset = showCill ? CILL_HEIGHT + 20 : 0;

            // Overall width dimension (top)
            windowModel.models.dimOverallWidth = createHorizontalDimension(M, 
                [0, height + DIM_OFFSET], 
                [width, height + DIM_OFFSET],
                `${width}`
            );

            // Overall height dimension (right)
            windowModel.models.dimOverallHeight = createVerticalDimension(M, 
                [width + DIM_OFFSET, 0], 
                [width + DIM_OFFSET, height],
                `${height}`
            );

            // Casement width dimensions (below window/cill)
            const dimY = -(DIM_OFFSET + cillOffset);
            let xOffset = frameThick;
            const mullionW = getMullionWidth();

            for (let i = 0; i < numCasements; i++) {
                const casementWidth = Math.round(casementWidths[i]);
                
                windowModel.models[`dimCasement_${i}`] = createHorizontalDimension(M,
                    [xOffset, dimY],
                    [xOffset + casementWidths[i], dimY],
                    `${casementWidth}`
                );

                xOffset += casementWidths[i];
                if (i < numCasements - 1) {
                    xOffset += mullionW;
                }
            }

            // Cill dimensions if shown
            if (showCill) {
                const cillWidth = width + (CILL_HORN_OVERHANG * 2);
                windowModel.models.dimCillWidth = createHorizontalDimension(M,
                    [-CILL_HORN_OVERHANG, -(CILL_HEIGHT + 40)],
                    [width + CILL_HORN_OVERHANG, -(CILL_HEIGHT + 40)],
                    `${cillWidth}`
                );
            }
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create horizontal dimension line with caption
        // ------------------------------------------------------------
        function createHorizontalDimension(M, start, end, text) {
            const y = start[1];
            const midX = (start[0] + end[0]) / 2;
            const witnessLength = DIM_OFFSET / 2.5;

            const dimModel = {
                paths: {
                    line: new M.paths.Line(start, end),
                    witnessStart: new M.paths.Line(
                        [start[0], y - witnessLength],
                        [start[0], y + witnessLength]
                    ),
                    witnessEnd: new M.paths.Line(
                        [end[0], y - witnessLength],
                        [end[0], y + witnessLength]
                    ),
                    arrowL1: new M.paths.Line(start, [start[0] + DIM_ARROW_SIZE, y + DIM_ARROW_SIZE / 2.5]),
                    arrowL2: new M.paths.Line(start, [start[0] + DIM_ARROW_SIZE, y - DIM_ARROW_SIZE / 2.5]),
                    arrowR1: new M.paths.Line(end, [end[0] - DIM_ARROW_SIZE, y + DIM_ARROW_SIZE / 2.5]),
                    arrowR2: new M.paths.Line(end, [end[0] - DIM_ARROW_SIZE, y - DIM_ARROW_SIZE / 2.5])
                },
                layer: DIM_LAYER
            };

            // Add caption using direct property assignment (degenerate anchor = horizontal text)
            dimModel.caption = {
                text: text,
                anchor: new M.paths.Line([midX, y], [midX, y])
            };

            return dimModel;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Create vertical dimension line with caption
        // ------------------------------------------------------------
        function createVerticalDimension(M, start, end, text) {
            const x = start[0];
            const midY = (start[1] + end[1]) / 2;
            const witnessLength = DIM_OFFSET / 2.5;

            const dimModel = {
                paths: {
                    line: new M.paths.Line(start, end),
                    witnessStart: new M.paths.Line(
                        [x - witnessLength, start[1]],
                        [x + witnessLength, start[1]]
                    ),
                    witnessEnd: new M.paths.Line(
                        [x - witnessLength, end[1]],
                        [x + witnessLength, end[1]]
                    ),
                    arrowB1: new M.paths.Line(start, [x + DIM_ARROW_SIZE / 2.5, start[1] + DIM_ARROW_SIZE]),
                    arrowB2: new M.paths.Line(start, [x - DIM_ARROW_SIZE / 2.5, start[1] + DIM_ARROW_SIZE]),
                    arrowT1: new M.paths.Line(end, [x + DIM_ARROW_SIZE / 2.5, end[1] - DIM_ARROW_SIZE]),
                    arrowT2: new M.paths.Line(end, [x - DIM_ARROW_SIZE / 2.5, end[1] - DIM_ARROW_SIZE])
                },
                layer: DIM_LAYER
            };

            // Add caption using direct property assignment (vertical anchor for rotated text)
            dimModel.caption = {
                text: text,
                anchor: new M.paths.Line([x, start[1]], [x, end[1]])
            };

            return dimModel;
        }
        // ---------------------------------------------------------------

        // FUNCTION | Render dimension text labels from model captions
        // ------------------------------------------------------------
        // Note: The Viewport uses useSvgPathOnly:true which prevents caption text
        // from rendering. This function reads caption data and creates text elements.
        // Text is placed OUTSIDE camera-group so it doesn't scale with zoom.
        // Uses cadToScreen() for absolute screen positioning.
        // ------------------------------------------------------------
        function renderDimensionCaptions() {
            if (!getShowDimensions()) return;

            const Viewport = window.CadGenerator.Viewport;
            const M        = Viewport.getMakerJS();
            const svg      = document.getElementById('cad-viewport-svg');
            
            if (!svg || !currentModel || !M) return;

            // Remove existing dimension labels
            const existingLabels = svg.querySelectorAll('.dim-caption');
            existingLabels.forEach(l => l.remove());

            const camState = Viewport.getState();

            // Create text group OUTSIDE camera-group so text doesn't scale with zoom
            // This ensures text remains readable at all zoom levels
            let textGroup = svg.querySelector('#dim-caption-group');
            if (!textGroup) {
                textGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                textGroup.id = 'dim-caption-group';
                svg.appendChild(textGroup);                                      // <-- Append to SVG root, not camera-group
            }
            textGroup.innerHTML = '';

            // Iterate through models to find captions
            function processModelCaptions(model, parentOrigin = [0, 0]) {
                if (!model) return;

                // Check if this model has a caption
                if (model.caption && model.caption.text && model.caption.anchor) {
                    const anchor = model.caption.anchor;
                    const anchorStart = anchor.origin;
                    const anchorEnd = anchor.end;
                    
                    // Calculate anchor midpoint in CAD coordinates
                    const midX = (anchorStart[0] + anchorEnd[0]) / 2 + parentOrigin[0];
                    const midY = (anchorStart[1] + anchorEnd[1]) / 2 + parentOrigin[1];
                    
                    // Calculate angle from anchor line (in CAD space)
                    const dx = anchorEnd[0] - anchorStart[0];
                    const dy = anchorEnd[1] - anchorStart[1];

                    // Create text element
                    const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                    text.setAttribute('class', 'dim-caption');
                    
                    // Text is OUTSIDE camera-group, so use cadToScreen for absolute positioning
                    const screenPos = cadToScreen(midX, midY, camState);
                    
                    text.setAttribute('x', screenPos.x);
                    text.setAttribute('y', screenPos.y);
                    text.setAttribute('text-anchor', 'middle');
                    text.setAttribute('dominant-baseline', 'middle');
                    text.setAttribute('font-family', 'Segoe UI, sans-serif');
                    text.setAttribute('font-size', '14px');                      // <-- Fixed pixel size, doesn't scale
                    text.setAttribute('font-weight', '600');
                    text.setAttribute('fill', '#e74c3c');
                    text.textContent = model.caption.text;

                    // Apply rotation for vertical/angled dimensions
                    const isVertical = Math.abs(dx) < 0.01 && Math.abs(dy) > 0.01;
                    const rotation = isVertical ? -90 : getTextRotation(dx, dy);

                    if (Math.abs(rotation) > 1) {
                        text.setAttribute('transform', `rotate(${rotation}, ${screenPos.x}, ${screenPos.y})`);
                    }

                    textGroup.appendChild(text);
                }

                // Process child models
                if (model.models) {
                    for (const key in model.models) {
                        const childModel = model.models[key];
                        const childOrigin = childModel.origin 
                            ? [parentOrigin[0] + childModel.origin[0], parentOrigin[1] + childModel.origin[1]]
                            : parentOrigin;
                        processModelCaptions(childModel, childOrigin);
                    }
                }
            }

            processModelCaptions(currentModel);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Apply layer-specific styling to SVG paths
        // ------------------------------------------------------------
        // Dimension lines need to be red but Viewport applies uniform stroke.
        // This post-processes the SVG to apply layer-specific colors.
        // ------------------------------------------------------------
        function applyLayerStyles() {
            const svg = document.getElementById('cad-viewport-svg');
            if (!svg) return;
            
            const flipGroup = svg.querySelector('#flip-group');
            if (!flipGroup) return;
            
            // MakerJS exports paths with layer info in path IDs or parent group IDs
            // Find all paths and apply red stroke to dimension layer elements
            const allPaths = flipGroup.querySelectorAll('path');
            allPaths.forEach(path => {
                const pathId = path.getAttribute('id') || '';
                const parentId = path.parentElement?.getAttribute('id') || '';
                
                // Check if path belongs to dimension layer (00__Dimensions)
                // or has dimension-related naming in the path/parent ID
                if (pathId.includes('00__Dimensions') || 
                    parentId.includes('00__Dimensions') ||
                    pathId.includes('dimOverall') || 
                    pathId.includes('dimCasement') || 
                    pathId.includes('dimCill')) {
                    path.setAttribute('stroke', '#e74c3c');                      // <-- Red dimension lines
                }
            });
            
            // Also check for groups that may contain dimension paths
            const allGroups = flipGroup.querySelectorAll('g');
            allGroups.forEach(group => {
                const groupId = group.getAttribute('id') || '';
                if (groupId.includes('00__Dimensions') || 
                    groupId.includes('dimOverall') || 
                    groupId.includes('dimCasement') || 
                    groupId.includes('dimCill')) {
                    // Apply red stroke to all paths within this dimension group
                    const childPaths = group.querySelectorAll('path');
                    childPaths.forEach(path => {
                        path.setAttribute('stroke', '#e74c3c');                  // <-- Red dimension lines
                    });
                }
            });
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Interactive Drag Handles
        // ---------------------------------------------------------------------

        // FUNCTION | Setup drag handles on mullions
        // ------------------------------------------------------------
        function setupDragHandles() {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;
            const svg      = document.getElementById('cad-viewport-svg');
            
            if (!svg) return;

            const numCasements = parseInt(UI.getValue('casements'));
            const windowHeight = parseInt(UI.getValue('windowHeight'));
            const frameThick   = getFrameThickness();
            const innerHeight  = windowHeight - (frameThick * 2);
            const mullionW     = getMullionWidth();
            
            // Remove existing handles
            const existingHandles = svg.querySelectorAll('.mullion-handle');
            existingHandles.forEach(h => h.remove());

            // Get camera state for coordinate conversion
            const camState = Viewport.getState();

            // Create invisible drag handles over each mullion
            let xOffset = frameThick;
            for (let i = 0; i < numCasements - 1; i++) {
                xOffset += casementWidths[i];
                
                // Define handle area in CAD coordinates
                const handleX = xOffset;
                const handleY = frameThick;
                const handleW = mullionW + 20;                                   // <-- Extra padding for easier dragging
                const handleH = innerHeight;

                // Convert corners to screen coordinates
                const topLeft = cadToScreen(handleX - 10, handleY + handleH, camState);
                const bottomRight = cadToScreen(handleX + handleW - 10, handleY, camState);

                // Calculate screen dimensions (may be inverted due to flip)
                const screenW = Math.abs(bottomRight.x - topLeft.x);
                const screenH = Math.abs(bottomRight.y - topLeft.y);
                const screenX = Math.min(topLeft.x, bottomRight.x);
                const screenY = Math.min(topLeft.y, bottomRight.y);

                const handle = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                handle.setAttribute('class', 'mullion-handle');
                handle.setAttribute('x', screenX);
                handle.setAttribute('y', screenY);
                handle.setAttribute('width', screenW);
                handle.setAttribute('height', screenH);
                handle.setAttribute('fill', '#007bff');
                handle.setAttribute('data-mullion-index', i);
                
                // Add drag events
                handle.addEventListener('mousedown', onMullionDragStart);
                
                svg.appendChild(handle);

                xOffset += mullionW;
            }

            // Setup document-level mouse events
            document.addEventListener('mousemove', onMullionDragMove);
            document.addEventListener('mouseup', onMullionDragEnd);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag start
        // ------------------------------------------------------------
        function onMullionDragStart(e) {
            e.preventDefault();
            e.stopPropagation();

            const mullionIndex = parseInt(e.target.dataset.mullionIndex);
            
            dragState = {
                active:       true,
                mullionIndex: mullionIndex,
                startX:       e.clientX,
                startWidths:  [...casementWidths]
            };

            e.target.classList.add('dragging');
            document.body.style.cursor = 'ew-resize';

            // Show feedback tooltip
            const feedback = document.getElementById('drag-feedback');
            feedback.style.display = 'block';
            updateDragFeedback(e.clientX, e.clientY);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag move
        // ------------------------------------------------------------
        function onMullionDragMove(e) {
            if (!dragState.active) return;

            const Viewport = window.CadGenerator.Viewport;
            const camState = Viewport.getState();
            
            // Calculate delta using coordinate system
            // For horizontal dragging, no Y-flip needed, only scale conversion
            const startScreen = { x: dragState.startX, y: 0 };               // <-- Y doesn't matter for horizontal drag
            const currentScreen = { x: e.clientX, y: 0 };

            const deltaScreen = currentScreen.x - startScreen.x;
            const deltaCAD = deltaScreen / camState.scale;                   // <-- Scale delta, no Y-flip for horizontal

            // Get adjacent casement indices
            const leftIdx  = dragState.mullionIndex;
            const rightIdx = dragState.mullionIndex + 1;

            // Calculate new widths
            let newLeftWidth  = dragState.startWidths[leftIdx] + deltaCAD;
            let newRightWidth = dragState.startWidths[rightIdx] - deltaCAD;

            // Enforce minimum widths
            if (newLeftWidth < MIN_CASEMENT_WIDTH) {
                newLeftWidth = MIN_CASEMENT_WIDTH;
                newRightWidth = dragState.startWidths[leftIdx] + dragState.startWidths[rightIdx] - MIN_CASEMENT_WIDTH;
            }
            if (newRightWidth < MIN_CASEMENT_WIDTH) {
                newRightWidth = MIN_CASEMENT_WIDTH;
                newLeftWidth = dragState.startWidths[leftIdx] + dragState.startWidths[rightIdx] - MIN_CASEMENT_WIDTH;
            }

            // Update widths
            casementWidths[leftIdx]  = newLeftWidth;
            casementWidths[rightIdx] = newRightWidth;

            // Update feedback
            updateDragFeedback(e.clientX, e.clientY);

            // Regenerate with preserved camera
            regenerateModel(true);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Handle mullion drag end
        // ------------------------------------------------------------
        function onMullionDragEnd(e) {
            if (!dragState.active) return;

            dragState.active = false;
            document.body.style.cursor = '';

            // Hide feedback
            const feedback = document.getElementById('drag-feedback');
            feedback.style.display = 'none';

            // Remove dragging class from handles
            const handles = document.querySelectorAll('.mullion-handle.dragging');
            handles.forEach(h => h.classList.remove('dragging'));

            // Final regenerate
            regenerateModel(true);
        }
        // ---------------------------------------------------------------

        // FUNCTION | Update drag feedback tooltip
        // ------------------------------------------------------------
        function updateDragFeedback(mouseX, mouseY) {
            const feedback = document.getElementById('drag-feedback');
            const leftIdx  = dragState.mullionIndex;
            const rightIdx = dragState.mullionIndex + 1;
            
            const leftWidth  = Math.round(casementWidths[leftIdx]);
            const rightWidth = Math.round(casementWidths[rightIdx]);

            feedback.textContent = `${leftWidth}mm | ${rightWidth}mm`;
            feedback.style.left = (mouseX + 15) + 'px';
            feedback.style.top  = (mouseY - 30) + 'px';
        }
        // ---------------------------------------------------------------
        // endregion -----------------------------------------------------------

        // ---------------------------------------------------------------------
        // REGION | Initialization
        // ---------------------------------------------------------------------
        window.onload = function() {
            const UI       = window.CadGenerator.DynamicUI;
            const Viewport = window.CadGenerator.Viewport;

            // Build primary UI from config
            UI.build(UI_CONFIG, UI_HANDLERS);

            // Build secondary controls
            buildSecondaryControls();

            // Initialize viewport (no guides for window configurator)
            Viewport.init('canvas-wrapper', {
                strokeColor:    '#2c3e50',
                strokeWidth:    2,
                fillColor:      'none',
                showGroundLine: false,
                showAxisLine:   false,
                fitPadding:     0.7                                              // <-- Tighter fit with margin
            });

            // Initialize casement widths
            initCasementWidths();

            // Wait for MakerJS to load
            let attempts = 0;
            const checkInt = setInterval(() => {
                const M = Viewport.getMakerJS();
                if (M) {
                    clearInterval(checkInt);
                    UI.showLoading(false);
                    
                    // Initial render with zoom extents
                    regenerateModel(false);
                } else if (attempts > 10) {
                    clearInterval(checkInt);
                    UI.setStatus('Failed to load libraries. Check connection.');
                }
                attempts++;
            }, 200);
        };
        // endregion -----------------------------------------------------------
    </script>
</body>
</html>
