{
    "id": "/valevision/",
    "name": "ValeVision 3D",
    "short_name": "ValeVision 3D",
    "description": "Vale Garden Houses' 3D project viewer: walk round a project, see its scenes and drawings.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#f5f5f5",
    "theme_color": "#172b3a",
    "icons": [
        { "src": "/AppAssets__CommonApplicationAssets/AppIcons/Na__AppInstallability__Icon__192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/AppAssets__CommonApplicationAssets/AppIcons/Na__AppInstallability__Icon__512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
    ],
    "related_applications": [
        { "platform": "webapp", "url": "https://app.valegardenhouses.com/valevision/ValeVision3D__Pwa__Manifest__.webmanifest" },
        { "platform": "webapp", "url": "https://app.valegardenhouses.com/project-gallery/ValeVisionGallery__Pwa__Manifest__.webmanifest" }
    ],
    "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
    "handle_links": "preferred",
    "prefer_related_applications": false
}
