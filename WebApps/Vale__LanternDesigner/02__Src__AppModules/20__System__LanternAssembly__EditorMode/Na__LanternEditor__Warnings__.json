            "userWarning": {
                "Label"       : "Document Warning",
                "Rank"        : 4,
                "BlocksIssue" : false,
                "Note"        : "Free text staff wrote in the Warnings and Comments section. Ranked above the automatic checks because a human flagged it, but never blocks issue - the app cannot judge free text, only the person who wrote it can."
            },
            "error": {
                "Label"    : "Not Manufacturable",
                "Rank"     : 3,
                "BlocksIssue" : true,
                "Note"     : "BlocksIssue means the drawing and specification modes refuse to issue while the warning stands."
            },
            "warning": {
                "Label"       : "Check Required",
                "Rank"        : 2,
                "BlocksIssue" : false
            },
            "info": {
                "Label"       : "For Information",
                "Rank"        : 1,
                "BlocksIssue" : false
            }
        },

