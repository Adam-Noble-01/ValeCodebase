# -----------------------------------------------------------------------------
# VALEVISION3D - EMAIL WORKER - ENV TEMPLATE
# -----------------------------------------------------------------------------
#
# Copy this file to `.dev.vars` (for local wrangler dev) and fill in the
# secret values marked with {{REDACTED}}.
#
# For production, set secrets via:
#   wrangler secret put MICROSOFT_CLIENT_SECRET
#   wrangler secret put EMAIL_ADDRESSBOOK_KEY_B64
#   wrangler secret put R2_SECRET_ACCESS_KEY
#
# Non-secret vars are configured in wrangler.jsonc under "vars".
#
# -----------------------------------------------------------------------------

# Cloudflare Access
CLOUDFLARE_ACCESS_TEAM_DOMAIN={{REDACTED}}
CLOUDFLARE_ACCESS_AUDIENCE={{REDACTED}}
ALLOWED_ORIGIN=https://adam-noble-01.github.io

# Microsoft Graph
MICROSOFT_TENANT_ID={{REDACTED}}
MICROSOFT_CLIENT_ID={{REDACTED}}
MICROSOFT_CLIENT_SECRET={{REDACTED}}
MICROSOFT_SENDER_USER={{REDACTED}}

# Address Book Encryption
EMAIL_ADDRESSBOOK_KEY_B64={{REDACTED}}

# Cloudflare R2
R2_ACCESS_KEY_ID={{REDACTED}}
R2_SECRET_ACCESS_KEY={{REDACTED}}
R2_BUCKET_NAME={{REDACTED}}
R2_ENDPOINT={{REDACTED}}
R2_TOKEN_VALUE={{REDACTED}}

# Rate Limiting
RATE_LIMIT_MAX_PER_HOUR=10
