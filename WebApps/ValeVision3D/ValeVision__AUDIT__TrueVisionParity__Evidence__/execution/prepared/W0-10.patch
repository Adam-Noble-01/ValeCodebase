+            if (kind === 'json') {
+                const text = await object.text();
+                try {
+                    answer.data = JSON.parse(text);
+                } catch {
+                    return na_files_json_response({ error : `${guard.path} on R2 is not valid JSON`, path : guard.path }, 500, requestOrigin, env);
+                }
