# =============================================================================
# WHITECARDOPEDIA EDITOR WORKER - SECRETS TEMPLATE
# =============================================================================
# These values are set as Wrangler secrets for deployment and as entries
# in Token__CloudflareAPI.env for the Flask server to serve to the browser.
#
# WRANGLER SECRETS (set before deploying):
#   npx wrangler secret put EDITOR_API_KEY
#   npx wrangler secret put ALLOWED_ORIGIN
#
# FLASK ENV KEYS (add to Tools__DevUtils/API__Cloudflare/Token__CloudflareAPI.env):
#   EDITOR_API_KEY=<same value as wrangler secret>
#   EDITOR_WORKER_URL=https://whitecardopedia-editor-api.adam-fb3.workers.dev/api/editor
#
# For local dev (wrangler dev on port 8787), set:
#   EDITOR_WORKER_URL=http://127.0.0.1:8787/api/editor
# =============================================================================

# API key required in X-Editor-Api-Key header for all editor save requests.
# Generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
EDITOR_API_KEY=your-secret-api-key-here

# Allowed CORS origin for the Worker (production deployment).
# On localhost dev this is not enforced by the Worker — all origins are accepted.
ALLOWED_ORIGIN=http://localhost:8000
