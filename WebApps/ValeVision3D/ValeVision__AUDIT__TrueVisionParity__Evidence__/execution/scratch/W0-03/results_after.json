 "helpPanel": {
  "standardRows": [
   "R | Reset camera to project start position",
   "B | Switch to orbit navigation mode",
   "T | Switch to walk (travel) navigation mode",
   "Y | Switch to fly navigation mode",
   "V | Toggle the presentation scene views panel",
   "Page Up | Cycle to the next scene in the presentation scenes list",
   "Page Down | Cycle to the previous scene in the presentation scenes list",
   "1 | Jump to the scene at this position in the current scene group (keys 1-9 match the visible thumbnail order)",
   "Alt + Backspace | Go back to the previous page (Whitecardopedia)"
  ],
  "advancedRows": [
   "2 | Jump to scene 2 in the current scene group",
   "3 | Jump to scene 3 in the current scene group",
   "4 | Jump to scene 4 in the current scene group",
   "5 | Jump to scene 5 in the current scene group",
   "6 | Jump to scene 6 in the current scene group",
   "7 | Jump to scene 7 in the current scene group",
   "8 | Jump to scene 8 in the current scene group",
   "9 | Jump to scene 9 in the current scene group",
   "Alt + Shift + F | Toggle fog effect and camera forcefield barrier planes",
   "D | Drawing markup: start a two-click dimension (while a drawing is on screen)",
   "O | Drawing markup: toggle ortho (axis-locked) dimension placement",
   "Arrows | Drawing markup: lock the dimension to an axis while placing",
   "Alt | Drawing markup: hold to place a true aligned dimension",
   "Shift | Drawing markup: hold to constrain a drag to an axis",
   "Ctrl+Z | Drawing markup: undo the focused markup layer",
   "Ctrl+Y | Drawing markup: redo the focused markup layer",
   "Ctrl+C / Ctrl+V | Drawing markup: copy and paste the selected annotation",
   "Delete | Drawing markup: delete the selected annotation or dimension",
   "Escape | Drawing markup: cancel placement or revert an edit"
  ],
  "advancedShown": true
